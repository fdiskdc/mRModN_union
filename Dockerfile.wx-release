ARG PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.11-slim
FROM ${PYTHON_IMAGE}

ARG DEBIAN_FRONTEND=noninteractive
ARG UV_VERSION=0.11.28
ARG DEBIAN_MIRROR=http://deb.debian.org/debian
ARG DEBIAN_SECURITY_MIRROR=http://deb.debian.org/debian-security

WORKDIR /app

RUN sed -i \
      -e "s|http://deb.debian.org/debian-security|${DEBIAN_SECURITY_MIRROR}|g" \
      -e "s|http://deb.debian.org/debian|${DEBIAN_MIRROR}|g" \
      /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Retries=5 update \
    && apt-get -o Acquire::Retries=5 install -y --fix-missing --no-install-recommends \
       build-essential ca-certificates curl redis-server supervisor tini \
    && python -m pip install --no-cache-dir "uv==${UV_VERSION}"

COPY mRModN_WebAndWx_backend/pyproject.toml mRModN_WebAndWx_backend/uv.lock ./
# The source lock file uses institutional mirrors; normalize them inside the image
# so the release build can run on a server with ordinary public egress.
RUN sed -i \
      -e "s|https://pypi.tuna.tsinghua.edu.cn|https://pypi.org|g" \
      -e "s|https://mirror.nju.edu.cn/pytorch/whl/cpu|https://download.pytorch.org/whl/cpu|g" \
      pyproject.toml uv.lock
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    PATH="/opt/venv/bin:${PATH}"
RUN uv sync --locked --no-dev --no-install-project

# mRModN source, checkpoint, LinearFold, JSON and all backend data.
COPY mRModN_WebAndWx_backend/ ./
RUN make -C LinearFold \
    && rm -f ./*.log celery.pid \
    && : > backend.env \
    && find . -type d -name __pycache__ -prune -exec rm -rf {} +

# Full SYSU-MM01 ReID dataset and every trained ReID output/checkpoint.
COPY SYSU-MM01/ /opt/reid/SYSU-MM01/
COPY outputs/ /opt/reid/outputs/

COPY docker/wx-supervisord.conf /etc/supervisor/conf.d/mrmodn-wx.conf
RUN mkdir -p /run/redis /var/log/supervisor \
    && chown -R redis:redis /run/redis \
    && test -f /opt/reid/outputs/best.pt \
    && test -d /opt/reid/SYSU-MM01/cam1 \
    && test -d /app/data

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    REDIS_HOST=127.0.0.1 \
    REDIS_PORT=6379 \
    REDIS_DB=0 \
    CELERY_BROKER_URL=redis://127.0.0.1:6379/0 \
    CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0 \
    MODEL_CHECKPOINT_PATH=/app/epoch_040.pt \
    MODEL_CONFIG_PATH=/app/json/human.json \
    MODEL_DEVICE=cpu \
    REID_CHECKPOINT_PATH=/opt/reid/outputs/best.pt \
    REID_DATA_ROOT=/opt/reid/SYSU-MM01 \
    REID_OUTPUT_DIR=/opt/reid/outputs \
    REID_DEVICE=cpu \
    REID_TORCH_NUM_THREADS=4 \
    REID_CACHE_SIZE=8 \
    PYTHONUNBUFFERED=1 \
    OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    GUNICORN_WORKERS=1 \
    CELERY_CONCURRENCY=1 \
    INTEGRATED_GRADIENTS_STEPS=32 \
    EXPLANATION_CACHE_TTL=604800

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=180s --retries=5 \
    CMD curl -fsS http://127.0.0.1:8000/api/v1/health >/dev/null || exit 1

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/usr/bin/supervisord", "-n", "-c", "/etc/supervisor/supervisord.conf"]
