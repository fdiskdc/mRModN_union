server {
    listen 443 ssl http2;
    server_name cmb.bnu.edu.cn;

    # Upload the Vite dist output to /var/www/mrmodn. Keeping root at
    # /var/www makes a request for /mrmodn/assets/* resolve correctly.
    root /var/www;
    index index.html;

    # Public /mrmodn/api/v1/* -> Flask internal /api/v1/*.
    location ^~ /mrmodn/api/ {
        rewrite ^/mrmodn(/api/.*)$ $1 break;
        proxy_pass http://127.0.0.1:9005;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # BrowserRouter refresh fallback under the same Vite base path.
    location /mrmodn/ {
        try_files $uri $uri/ /mrmodn/index.html;
    }
}
