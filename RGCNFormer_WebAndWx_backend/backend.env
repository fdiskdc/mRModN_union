# ============================================================================
# RGCNFormer WebAndWx Backend - Unified Configuration
# ============================================================================
# This is the canonical, non-hidden backend configuration file.
# Values supplied by the operating system or container environment take
# precedence over values declared here.

# ----------------------------------------------------------------------------
# Redis
# ----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ----------------------------------------------------------------------------
# Celery
# ----------------------------------------------------------------------------
CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=3000
CELERY_CONCURRENCY=1

# ----------------------------------------------------------------------------
# Model
# ----------------------------------------------------------------------------
MODEL_CHECKPOINT_PATH=epoch_040.pt
MODEL_CONFIG_PATH=json/human.json
MODEL_DEVICE=cpu
MODEL_TARGET_LENGTH=1001

# ----------------------------------------------------------------------------
# ReID body heatmaps (CPU only)
# ----------------------------------------------------------------------------
REID_CHECKPOINT_PATH=../outputs/best.pt
REID_DATA_ROOT=../SYSU-MM01
REID_OUTPUT_DIR=../outputs
REID_DEVICE=cpu
REID_TORCH_NUM_THREADS=4
REID_CACHE_SIZE=8

# ----------------------------------------------------------------------------
# Server
# ----------------------------------------------------------------------------
FLASK_HOST=0.0.0.0
FLASK_PORT=8000
BACKEND_PORT=9005
FLASK_DEBUG=False
GUNICORN_WORKERS=1

# ----------------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT='%(asctime)s - %(name)s - %(levelname)s - [%(funcName)s:%(lineno)d] - %(message)s'
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5

# ----------------------------------------------------------------------------
# Cache
# ----------------------------------------------------------------------------
REDIS_CACHE_TTL=3600

# ----------------------------------------------------------------------------
# Classification thresholds (12-class)
# ----------------------------------------------------------------------------
THRESHOLD_12_AM=0.510
THRESHOLD_12_ATOL=0.400
THRESHOLD_12_CM=0.690
THRESHOLD_12_GM=0.710
THRESHOLD_12_TM=0.350
THRESHOLD_12_Y=0.150
THRESHOLD_12_AC4C=0.120
THRESHOLD_12_M1A=0.380
THRESHOLD_12_M5C=0.350
THRESHOLD_12_M6A=0.260
THRESHOLD_12_M6AM=0.570
THRESHOLD_12_M7G=0.130

# ----------------------------------------------------------------------------
# Classification thresholds (4-class)
# ----------------------------------------------------------------------------
THRESHOLD_4_A=0.980
THRESHOLD_4_C=0.270
THRESHOLD_4_G=0.050
THRESHOLD_4_U=0.050

# ----------------------------------------------------------------------------
# Visualization data
# ----------------------------------------------------------------------------
DEFAULT_TOP_K=3
MODEL_COMPARISON_CSV_DIR=data
DATASET_COMPARISON_XLSX=data/CORA-CITE-AMAP-BAT-EAT.xlsx
UMAP_DATA_PATH=data/umap_human_data.json
UMAP_CORA_DATA_PATH=data/umap_cora_data.json
DATA_DIR=./data

# ----------------------------------------------------------------------------
# WeChat Mini Program
# ----------------------------------------------------------------------------
# Leave blank until real credentials are available.
WX_APPID=
WX_SECRET=
