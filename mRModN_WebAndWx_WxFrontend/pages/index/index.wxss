.home-page{padding-top:24rpx}.brand-row{display:flex;align-items:center;justify-content:space-between}.brand,.brand-en{display:block}.brand{font-size:42rpx;font-weight:900;letter-spacing:1rpx;color:#607283}.brand-en{font-size:20rpx;color:#6F777B;margin-top:2rpx}.user{display:flex;align-items:center;gap:12rpx;color:#6F777B;font-size:24rpx}.user image{width:62rpx;height:62rpx;border-radius:50%;border:4rpx solid #FAF9F6;box-shadow:0 6rpx 18rpx rgba(58,67,70,.10)}.login{margin:0;width:128rpx;height:64rpx;line-height:64rpx;border-radius:32rpx;background:#E4E9EC;color:#607283;font-size:24rpx;font-weight:700}.hero{position:relative;overflow:hidden;margin-top:28rpx;padding:42rpx 36rpx;border:2rpx solid rgba(255,255,255,.18);border-radius:30rpx;color:#FEFDFC;background:linear-gradient(145deg,#667A89 0%,#718394 56%,#7E8F8B 100%);box-shadow:0 18rpx 42rpx rgba(74,88,94,.16)}.hero::after{content:"";position:absolute;right:-80rpx;bottom:-120rpx;width:300rpx;height:300rpx;border-radius:50%;background:rgba(255,255,255,.07)}.eyebrow{font-size:22rpx;opacity:.82;letter-spacing:2rpx}.hero-title{position:relative;z-index:1;display:block;font-size:42rpx;line-height:1.3;font-weight:900;margin:14rpx 0}.hero-desc{position:relative;z-index:1;display:block;font-size:25rpx;line-height:1.7;opacity:.9}.chips{position:relative;z-index:1;display:flex;flex-wrap:wrap;gap:12rpx;margin-top:28rpx}.chips text{padding:10rpx 17rpx;border:1rpx solid rgba(255,255,255,.18);border-radius:999rpx;background:rgba(255,255,255,.11);font-size:21rpx}.section-head{display:flex;justify-content:space-between;align-items:flex-end;margin:40rpx 0 20rpx}.section-title,.section-note{display:block}.section-title{font-size:33rpx;font-weight:800;color:#39434A}.section-note{font-size:21rpx;color:#6F777B;margin-top:7rpx}.tools{display:flex;gap:22rpx;color:#607283;font-size:23rpx;font-weight:600}.tools .disabled{color:#979B9B;pointer-events:none}.sequence-list{display:flex;flex-direction:column;gap:22rpx}.add-button{margin-top:20rpx;height:82rpx;line-height:82rpx;border:2rpx dashed #9DAAB2;background:#EEEDE9;color:#607283;border-radius:20rpx;font-size:26rpx}.capability{margin-top:34rpx;background:#FAF9F6;border:2rpx solid #D8D5CE;border-radius:24rpx;padding:28rpx;box-shadow:0 8rpx 24rpx rgba(58,67,70,.05)}.cap-title{font-size:28rpx;font-weight:800;color:#39434A}.cap-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx;margin-top:22rpx}.cap-grid view{padding:22rpx 8rpx;text-align:center;background:#EEEDE9;border:1rpx solid #E2DED7;border-radius:16rpx}.cap-grid b,.cap-grid text{display:block}.cap-grid b{color:#607283;font-size:27rpx}.cap-grid text{font-size:22rpx;color:#6F777B;margin-top:6rpx}.bottom-action{position:fixed;z-index:80;left:0;right:0;bottom:0;padding:20rpx 32rpx;background:rgba(250,249,246,.96);border-top:1rpx solid #D8D5CE;box-shadow:0 -10rpx 28rpx rgba(58,67,70,.07)}
