.home-page{padding-top:24rpx}.brand-row{display:flex;align-items:center;justify-content:space-between}.brand,.brand-en{display:block}.brand{font-size:42rpx;font-weight:900;letter-spacing:1rpx;color:#5267D8}.brand-en{font-size:20rpx;color:#6C7588;margin-top:2rpx}.user{display:flex;align-items:center;gap:12rpx;color:#6C7588;font-size:24rpx}.user image{width:62rpx;height:62rpx;border-radius:50%;border:4rpx solid #fff;box-shadow:0 6rpx 18rpx rgba(23,32,51,.12)}.login{margin:0;width:128rpx;height:64rpx;line-height:64rpx;border-radius:16rpx;background:#EEF1FF;color:#5267D8;font-size:24rpx}.hero{margin-top:28rpx;padding:38rpx 34rpx;border-radius:28rpx;color:#fff;background:linear-gradient(145deg,#5267D8,#6E7FE3 62%,#28A69A);box-shadow:0 18rpx 46rpx rgba(82,103,216,.25)}.eyebrow{font-size:22rpx;opacity:.8}.hero-title{display:block;font-size:42rpx;line-height:1.3;font-weight:900;margin:12rpx 0}.hero-desc{display:block;font-size:25rpx;line-height:1.65;opacity:.9}.chips{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:26rpx}.chips text{padding:10rpx 16rpx;border-radius:999rpx;background:rgba(255,255,255,.16);font-size:21rpx}.section-head{display:flex;justify-content:space-between;align-items:flex-end;margin:38rpx 0 20rpx}.section-title,.section-note{display:block}.section-title{font-size:33rpx;font-weight:850}.section-note{font-size:21rpx;color:#6C7588;margin-top:6rpx}.tools{display:flex;gap:20rpx;color:#5267D8;font-size:23rpx}.tools .disabled{color:#9AA1B1;pointer-events:none}.sequence-list{display:flex;flex-direction:column;gap:22rpx}.add-button{margin-top:20rpx;height:82rpx;line-height:82rpx;border:2rpx dashed #AEB8EC;background:#F7F8FE;color:#5267D8;border-radius:20rpx;font-size:26rpx}.capability{margin-top:34rpx;background:#fff;border-radius:24rpx;padding:28rpx}.cap-title{font-size:28rpx;font-weight:800}.cap-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx;margin-top:22rpx}.cap-grid view{padding:20rpx 8rpx;text-align:center;background:#F7F8FC;border-radius:16rpx}.cap-grid b,.cap-grid text{display:block}.cap-grid b{color:#5267D8;font-size:27rpx}.cap-grid text{font-size:22rpx;color:#6C7588;margin-top:6rpx}.bottom-action{position:fixed;z-index:80;left:0;right:0;bottom:0;padding:20rpx 32rpx;background:rgba(255,255,255,.96);box-shadow:0 -12rpx 30rpx rgba(23,32,51,.08)}
