<view class="page-shell home-page">
  <app-header isLoggedIn="{{isLoggedIn}}" isLogging="{{isLogging}}" userInfo="{{userInfo}}" bindlogin="onLoginTap" bindlogout="onLogoutTap"></app-header>
  <view class="hero"><text class="eyebrow">Mobile Research Toolkit</text><text class="hero-title">RNA Modification Prediction & Structure Visualization</text><text class="hero-desc">Submit once to obtain predictions for 12 modification types, attention sites, and RNA secondary structure.</text><view class="chips"><text>12 modification types</text><text>Up to 5 sequences</text><text>2D / 3D structures</text></view></view>
  <view class="section-head"><view><text class="section-title">Enter RNA Sequences</text><text class="section-note">At least 51 nt; A/C/G/U/T/N only</text></view><view class="tools"><text class="{{isLoadingExample ? 'disabled' : ''}}" bindtap="useExample">{{isLoadingExample ? 'Loading Example…' : 'New Example'}}</text><text bindtap="clearAll">Clear</text></view></view>
  <view class="sequence-list"><sequence-card wx:for="{{rnaSequences}}" wx:key="index" index="{{index}}" value="{{item.value}}" removable="{{rnaSequences.length > 1}}" bindchange="onSequenceChange" bindremove="onDeleteSequence"></sequence-card></view>
  <button wx:if="{{rnaSequences.length < 5}}" class="add-button" bindtap="onAddSequence">+ Add Sequence ({{rnaSequences.length}} / 5)</button>
  <view class="capability"><text class="cap-title">Analysis Includes</text><view class="cap-grid"><view><b>01</b><text>Modification Classification</text></view><view><b>02</b><text>Attention Distribution</text></view><view><b>03</b><text>RNA Structure</text></view></view></view>
</view>
<view class="bottom-action safe-bottom"><button class="primary-button" loading="{{isSubmitting}}" disabled="{{isSubmitting}}" bindtap="onSubmitTap">{{isSubmitting ? 'Submitting…' : 'Start Analysis'}}</button></view>
<analysis-progress visible="{{showProgress}}" current="{{progressCurrent}}" total="{{progressTotal}}"></analysis-progress>
