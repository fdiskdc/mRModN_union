.results-page{padding-top:24rpx;padding-bottom:calc(150rpx + env(safe-area-inset-bottom))}.topbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:24rpx}.title,.task-id{display:block}.title{font-size:40rpx;font-weight:900;color:#39434A}.task-id{max-width:520rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#6F777B;font-size:20rpx;margin-top:4rpx}.back{color:#607283;font-size:25rpx;font-weight:700}.sequence-tabs{white-space:nowrap;margin-bottom:20rpx}.sequence-row{display:flex;gap:14rpx}.sequence-tab{flex:none;padding:18rpx 26rpx;border-radius:16rpx;background:#FAF9F6;border:2rpx solid #D8D5CE;color:#596265}.sequence-tab text{display:block}.sequence-tab text:first-child{font-weight:700}.sequence-tab text:last-child{font-size:20rpx;color:#6F777B;margin-top:4rpx}.sequence-tab.active{background:#E4E9EC;border-color:#A9B7BF;color:#607283;box-shadow:0 5rpx 14rpx rgba(91,108,120,.08)}.content{margin-top:22rpx}.subtabs{display:grid;grid-template-columns:1fr 1fr;background:#E3E1DC;padding:6rpx;border-radius:16rpx;margin-bottom:18rpx}.subtabs view{text-align:center;padding:18rpx;border-radius:12rpx;color:#6F777B}.subtabs .active{background:#FAF9F6;color:#607283;font-weight:700;box-shadow:0 4rpx 12rpx rgba(58,67,70,.07)}.distribution-panel{display:flex;flex-direction:column;gap:18rpx}.distribution-controls{display:flex;justify-content:space-between;align-items:center;background:#FAF9F6;border:2rpx solid #D8D5CE;border-radius:18rpx;padding:18rpx 22rpx}.class-picker{min-width:280rpx;color:#39434A;font-weight:700}.all-switch{display:flex;align-items:center;gap:8rpx;color:#6F777B;font-size:22rpx}.inline-loading,.loading{padding:80rpx;text-align:center;color:#6F777B}.loading{min-height:60vh;display:flex;flex-direction:column;align-items:center;justify-content:center}.spinner{width:64rpx;height:64rpx;border:7rpx solid #E4E9EC;border-top-color:#718394;border-radius:50%;animation:spin 1s linear infinite;margin-bottom:20rpx}.structure-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:18rpx}.section-title,.section-desc{display:block}.section-title{font-size:31rpx;font-weight:800;color:#39434A}.section-desc{font-size:21rpx;color:#6F777B;margin-top:4rpx}.structure-head button{margin:0;padding:0 22rpx;height:66rpx;line-height:66rpx;border-radius:14rpx;background:#718394;color:#FEFDFC;font-size:23rpx;box-shadow:0 6rpx 16rpx rgba(91,108,120,.13)}@keyframes spin{to{transform:rotate(360deg)}}
.result-bottom-nav{position:fixed;z-index:100;left:0;right:0;bottom:0;display:grid;grid-template-columns:repeat(5,1fr);gap:8rpx;padding:12rpx 20rpx calc(12rpx + env(safe-area-inset-bottom));background:rgba(250,249,246,.98);border-top:2rpx solid #D8D5CE;box-shadow:0 -10rpx 28rpx rgba(58,67,70,.08)}.bottom-nav-item{display:flex;min-width:0;flex-direction:column;align-items:center;justify-content:center;gap:5rpx;padding:10rpx 2rpx;border-radius:16rpx;color:#868D8D}.bottom-nav-icon{display:flex;align-items:center;justify-content:center;min-width:48rpx;height:42rpx;padding:0 8rpx;border-radius:14rpx;font-size:28rpx;line-height:1;font-weight:800}.bottom-nav-label{max-width:100%;font-size:19rpx;line-height:1.25;white-space:nowrap}.bottom-nav-item.active{color:#607283;font-weight:800}.bottom-nav-item.active .bottom-nav-icon{background:#E4E9EC;box-shadow:inset 0 0 0 1rpx #CBD4D9}
.interpretability-panel{display:flex;flex-direction:column;gap:20rpx}.interpretability-tabs{margin-bottom:20rpx}.explanation-controls{display:flex;flex-direction:column;gap:16rpx;margin-bottom:20rpx;padding:20rpx;background:#FAF9F6;border:2rpx solid #D8D5CE;border-radius:22rpx;box-shadow:0 8rpx 24rpx rgba(58,67,70,.05)}.control-field{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:18rpx 20rpx;background:#EEEDE9;border:1rpx solid #E0DDD6;border-radius:14rpx;color:#6F777B;font-size:23rpx}.control-field text:last-child{color:#39434A;font-weight:800}.target-input{align-items:center}.target-input input{width:180rpx;text-align:right;color:#39434A;font-weight:800}.compute-button{width:100%;height:76rpx;line-height:76rpx;margin:0;background:#718394;color:#FEFDFC;border-radius:16rpx;font-size:25rpx;font-weight:800;box-shadow:0 7rpx 18rpx rgba(91,108,120,.13)}.compute-button[disabled]{background:#BCC4C8;color:#F2F2EF;box-shadow:none}.explanation-loading,.explanation-error{display:flex;align-items:center;justify-content:center;gap:14rpx;padding:28rpx;border-radius:18rpx;margin-bottom:20rpx}.explanation-loading{background:#E4E9EC;color:#607283}.explanation-error{background:#F2E3E0;color:#985B52}.spinner.small{width:34rpx;height:34rpx;border-width:5rpx;margin:0}
