.results-page{padding-top:24rpx}.topbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:24rpx}.title,.task-id{display:block}.title{font-size:40rpx;font-weight:900}.task-id{max-width:520rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#6C7588;font-size:20rpx;margin-top:4rpx}.back{color:#5267D8;font-size:25rpx}.sequence-tabs{white-space:nowrap;margin-bottom:20rpx}.sequence-row{display:flex;gap:14rpx}.sequence-tab{flex:none;padding:18rpx 26rpx;border-radius:16rpx;background:#fff;border:2rpx solid #E8EBF2}.sequence-tab text{display:block}.sequence-tab text:first-child{font-weight:700}.sequence-tab text:last-child{font-size:20rpx;color:#6C7588;margin-top:4rpx}.sequence-tab.active{background:#EEF1FF;border-color:#AAB5ED;color:#5267D8}.content{margin-top:22rpx}.subtabs{display:grid;grid-template-columns:1fr 1fr;background:#E9ECF4;padding:6rpx;border-radius:16rpx;margin-bottom:18rpx}.subtabs view{text-align:center;padding:18rpx;border-radius:12rpx;color:#6C7588}.subtabs .active{background:#fff;color:#5267D8;font-weight:700;box-shadow:0 4rpx 14rpx rgba(23,32,51,.08)}.distribution-panel{display:flex;flex-direction:column;gap:18rpx}.distribution-controls{display:flex;justify-content:space-between;align-items:center;background:#fff;border-radius:18rpx;padding:18rpx 22rpx}.class-picker{min-width:280rpx;color:#172033;font-weight:700}.all-switch{display:flex;align-items:center;gap:8rpx;color:#6C7588;font-size:22rpx}.inline-loading,.loading{padding:80rpx;text-align:center;color:#6C7588}.loading{min-height:60vh;display:flex;flex-direction:column;align-items:center;justify-content:center}.spinner{width:64rpx;height:64rpx;border:7rpx solid #E5E9F8;border-top-color:#5267D8;border-radius:50%;animation:spin 1s linear infinite;margin-bottom:20rpx}.structure-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:18rpx}.section-title,.section-desc{display:block}.section-title{font-size:31rpx;font-weight:800}.section-desc{font-size:21rpx;color:#6C7588;margin-top:4rpx}.structure-head button{margin:0;padding:0 22rpx;height:66rpx;line-height:66rpx;border-radius:14rpx;background:#5267D8;color:#fff;font-size:23rpx}@keyframes spin{to{transform:rotate(360deg)}}
