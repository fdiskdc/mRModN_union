.results-page{padding-top:24rpx;padding-bottom:calc(150rpx + env(safe-area-inset-bottom))}.topbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:24rpx}.title,.task-id{display:block}.title{font-size:40rpx;font-weight:900}.task-id{max-width:520rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#6C7588;font-size:20rpx;margin-top:4rpx}.back{color:#5267D8;font-size:25rpx}.sequence-tabs{white-space:nowrap;margin-bottom:20rpx}.sequence-row{display:flex;gap:14rpx}.sequence-tab{flex:none;padding:18rpx 26rpx;border-radius:16rpx;background:#fff;border:2rpx solid #E8EBF2}.sequence-tab text{display:block}.sequence-tab text:first-child{font-weight:700}.sequence-tab text:last-child{font-size:20rpx;color:#6C7588;margin-top:4rpx}.sequence-tab.active{background:#EEF1FF;border-color:#AAB5ED;color:#5267D8}.content{margin-top:22rpx}.subtabs{display:grid;grid-template-columns:1fr 1fr;background:#E9ECF4;padding:6rpx;border-radius:16rpx;margin-bottom:18rpx}.subtabs view{text-align:center;padding:18rpx;border-radius:12rpx;color:#6C7588}.subtabs .active{background:#fff;color:#5267D8;font-weight:700;box-shadow:0 4rpx 14rpx rgba(23,32,51,.08)}.distribution-panel{display:flex;flex-direction:column;gap:18rpx}.distribution-controls{display:flex;justify-content:space-between;align-items:center;background:#fff;border-radius:18rpx;padding:18rpx 22rpx}.class-picker{min-width:280rpx;color:#172033;font-weight:700}.all-switch{display:flex;align-items:center;gap:8rpx;color:#6C7588;font-size:22rpx}.inline-loading,.loading{padding:80rpx;text-align:center;color:#6C7588}.loading{min-height:60vh;display:flex;flex-direction:column;align-items:center;justify-content:center}.spinner{width:64rpx;height:64rpx;border:7rpx solid #E5E9F8;border-top-color:#5267D8;border-radius:50%;animation:spin 1s linear infinite;margin-bottom:20rpx}.structure-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:18rpx}.section-title,.section-desc{display:block}.section-title{font-size:31rpx;font-weight:800}.section-desc{font-size:21rpx;color:#6C7588;margin-top:4rpx}.structure-head button{margin:0;padding:0 22rpx;height:66rpx;line-height:66rpx;border-radius:14rpx;background:#5267D8;color:#fff;font-size:23rpx}@keyframes spin{to{transform:rotate(360deg)}}
.result-bottom-nav{position:fixed;z-index:100;left:0;right:0;bottom:0;display:grid;grid-template-columns:repeat(5,1fr);gap:8rpx;padding:12rpx 20rpx calc(12rpx + env(safe-area-inset-bottom));background:#fff;border-top:2rpx solid #E5E8F0;box-shadow:0 -12rpx 30rpx rgba(23,32,51,.12)}
.bottom-nav-item{display:flex;min-width:0;flex-direction:column;align-items:center;justify-content:center;gap:4rpx;padding:10rpx 2rpx;border-radius:16rpx;color:#8D94A3}
.bottom-nav-icon{font-size:32rpx;line-height:1;font-weight:800}
.bottom-nav-label{max-width:100%;font-size:21rpx;line-height:1.25;white-space:nowrap}
.bottom-nav-item.active{background:#EEF1FF;color:#5267D8;font-weight:800}

.interpretability-panel{display:flex;flex-direction:column;gap:20rpx}.interpretability-tabs{margin-bottom:20rpx}.explanation-controls{display:flex;flex-direction:column;gap:16rpx;margin-bottom:20rpx;padding:20rpx;background:#fff;border:2rpx solid #E5E8F0;border-radius:22rpx}.control-field{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:18rpx 20rpx;background:#F5F7FC;border-radius:14rpx;color:#6C7588;font-size:23rpx}.control-field text:last-child{color:#172033;font-weight:800}.target-input{align-items:center}.target-input input{width:180rpx;text-align:right;color:#172033;font-weight:800}.compute-button{width:100%;height:76rpx;line-height:76rpx;margin:0;background:#5267D8;color:#fff;border-radius:16rpx;font-size:25rpx;font-weight:800}.compute-button[disabled]{background:#AEB8EA;color:#fff}.explanation-loading,.explanation-error{display:flex;align-items:center;justify-content:center;gap:14rpx;padding:28rpx;border-radius:18rpx;margin-bottom:20rpx}.explanation-loading{background:#EEF1FF;color:#4057C5}.explanation-error{background:#FFF0EE;color:#BC4935}.spinner.small{width:34rpx;height:34rpx;border-width:5rpx;margin:0}.bottom-nav-icon{font-size:28rpx}.bottom-nav-label{font-size:19rpx}
