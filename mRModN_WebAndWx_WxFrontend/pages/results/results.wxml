<view class="page-shell results-page">
  <view wx:if="{{isLoading}}" class="loading"><view class="spinner"></view><text>Loading analysis results…</text></view>
  <error-state wx:elif="{{error}}" message="{{error}}" bindretry="retry"></error-state>
  <block wx:elif="{{currentResult}}">
    <view class="topbar"><view><text class="title">Analysis Results</text><text class="task-id">Batch {{batchJobId}}</text></view><text class="back" bindtap="backHome">Back</text></view>
    <scroll-view wx:if="{{results.length > 1}}" scroll-x class="sequence-tabs"><view class="sequence-row"><view wx:for="{{results}}" wx:key="jobId" class="sequence-tab {{currentResultIndex === index ? 'active' : ''}}" data-index="{{index}}" bindtap="onSequenceTab"><text>Sequence {{index + 1}}</text><text>{{item.sequenceLength}} nt</text></view></view></scroll-view>
    <view class="content">
      <result-summary wx:if="{{currentResultTab === 'overview'}}" result="{{currentResult}}"></result-summary>
      <classification-tree wx:elif="{{currentResultTab === 'classification'}}" classification="{{currentResult.classification}}"></classification-tree>
      <view wx:elif="{{currentResultTab === 'attention'}}">
        <view class="subtabs"><view class="{{attentionMode === 'sites' ? 'active' : ''}}" data-mode="sites" bindtap="setAttentionMode">Key Sites</view><view class="{{attentionMode === 'distribution' ? 'active' : ''}}" data-mode="distribution" bindtap="setAttentionMode">Full Distribution</view></view>
        <attention-sites wx:if="{{attentionMode === 'sites'}}" sequence="{{currentResult.sequence}}" weights="{{currentResult.attentionWeights}}" modification-names="{{currentResult.modificationNames}}" bindselectsite="onAttentionSite"></attention-sites>
        <view wx:else class="distribution-panel">
          <view class="distribution-controls"><picker mode="selector" range="{{attentionClasses}}" range-key="name" value="{{attentionClassIndex}}" bindchange="onAttentionClass"><view class="class-picker">{{selectedAttentionClass ? selectedAttentionClass.name : 'Select a modification class'}}⌄</view></picker><view class="all-switch"><switch checked="{{!predictedOnly}}" color="#718394" bindchange="toggleAllClasses"></switch><text>All classes</text></view></view>
          <view wx:if="{{loadingAttention}}" class="inline-loading">Loading cached data…</view>
          <attention-chart wx:elif="{{selectedAttentionClass}}" class-data="{{selectedAttentionClass}}" sequence-length="{{attentionDistribution.sequence_length}}" modeled-start="{{attentionDistribution.modeled_range.start}}" selected-position="{{selectedPosition}}" bindselect="onChartSelect"></attention-chart>
          <empty-state wx:else title="No Full Attention Data" description="Older tasks may not have cached data. Submit a new task to generate it."></empty-state>
        </view>
      </view>
      <view wx:elif="{{currentResultTab === 'structure'}}">
        <view class="structure-head"><view><text class="section-title">RNA Secondary Structure</text><text class="section-desc">Top attention sites are highlighted in the graph</text></view><button bindtap="openWebView">Interactive 3D</button></view>
        <rna-graph graph="{{currentResult.gcn}}" sequence="{{currentResult.sequence}}" highlighted-indices="{{currentResult.highlightedIndices}}" selected-index="{{selectedPosition}}" bindselect="onGraphSelect"></rna-graph>
      </view>
      <view wx:elif="{{currentResultTab === 'interpretability'}}" class="interpretability-panel">
        <view class="subtabs interpretability-tabs"><view class="{{interpretabilityMode === 'integrated-gradients' ? 'active' : ''}}" data-mode="integrated-gradients" bindtap="setInterpretabilityMode">Integrated Gradients</view><view class="{{interpretabilityMode === 'gcn' ? 'active' : ''}}" data-mode="gcn" bindtap="setInterpretabilityMode">GCN Message Passing</view></view>
        <view wx:if="{{interpretabilityMode === 'integrated-gradients'}}">
          <view class="explanation-controls">
            <picker mode="selector" range="{{modificationOptions}}" range-key="name" value="{{igClassIndex}}" bindchange="onIgClassChange"><view class="control-field"><text>Target Modification</text><text>{{modificationOptions[igClassIndex].name}}⌄</text></view></picker>
            <picker mode="selector" range="{{topKOptions}}" value="{{igTopKIndex}}" bindchange="onIgTopKChange"><view class="control-field"><text>Key Sites</text><text>Top {{topKOptions[igTopKIndex]}}⌄</text></view></picker>
            <button class="compute-button" loading="{{igLoading}}" disabled="{{igLoading}}" bindtap="runIntegratedGradients">{{igLoading ? 'Computing…' : 'Compute Integrated Gradients'}}</button>
          </view>
          <view wx:if="{{igError}}" class="explanation-error">{{igError}}</view>
          <view wx:if="{{igLoading}}" class="explanation-loading"><view class="spinner small"></view><text>Running Integrated Gradients. You may leave this page and return later.</text></view>
          <integrated-gradients wx:elif="{{igResult}}" sequence="{{currentResult.sequence}}" result="{{igResult}}" top-k="{{topKOptions[igTopKIndex]}}" bindselect="onExplanationGraphSelect"></integrated-gradients>
          <empty-state wx:else title="Integrated Gradients Not Computed" description="Select a target modification class, then start the computation. Positive and negative contributions use different colors; other positions remain gray."></empty-state>
        </view>
        <view wx:else>
          <view class="explanation-controls">
            <view class="control-field target-input"><text>Target Position (1–{{currentResult.sequenceLength}})</text><input type="number" value="{{gcnTargetPosition}}" bindinput="onGcnTargetInput"/></view>
            <button class="compute-button" loading="{{gcnLoading}}" disabled="{{gcnLoading}}" bindtap="runGcnMessagePassing">{{gcnLoading ? 'Computing…' : 'Compute Message Passing'}}</button>
          </view>
          <view wx:if="{{gcnError}}" class="explanation-error">{{gcnError}}</view>
          <view wx:if="{{gcnLoading}}" class="explanation-loading"><view class="spinner small"></view><text>Extracting messages from each GCN layer.</text></view>
          <gcn-message-passing wx:elif="{{gcnResult}}" sequence="{{currentResult.sequence}}" result="{{gcnResult}}" bindselect="onExplanationGraphSelect"></gcn-message-passing>
          <empty-state wx:else title="GCN Message Passing Not Computed" description="Enter a target nucleotide position to inspect message strength across GCN layers."></empty-state>
        </view>
      </view>
    </view>
    <view class="result-bottom-nav safe-bottom"><view wx:for="{{resultTabs}}" wx:key="value" class="bottom-nav-item {{currentResultTab === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="onResultTabTap"><text class="bottom-nav-icon">{{item.icon}}</text><text class="bottom-nav-label">{{item.label}}</text></view></view>
  </block>
</view>
