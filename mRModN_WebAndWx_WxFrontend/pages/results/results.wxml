<view class="page-shell results-page">
  <view wx:if="{{isLoading}}" class="loading"><view class="spinner"></view><text>正在加载分析结果…</text></view>
  <error-state wx:elif="{{error}}" message="{{error}}" bindretry="retry"></error-state>
  <block wx:elif="{{currentResult}}">
    <view class="topbar"><view><text class="title">分析结果</text><text class="task-id">批次 {{batchJobId}}</text></view><text class="back" bindtap="backHome">返回</text></view>
    <scroll-view wx:if="{{results.length > 1}}" scroll-x class="sequence-tabs"><view class="sequence-row"><view wx:for="{{results}}" wx:key="jobId" class="sequence-tab {{currentResultIndex === index ? 'active' : ''}}" data-index="{{index}}" bindtap="onSequenceTab"><text>序列 {{index + 1}}</text><text>{{item.sequenceLength}} nt</text></view></view></scroll-view>
    <view class="content">
      <result-summary wx:if="{{currentResultTab === 'overview'}}" result="{{currentResult}}"></result-summary>
      <classification-tree wx:elif="{{currentResultTab === 'classification'}}" classification="{{currentResult.classification}}"></classification-tree>
      <view wx:elif="{{currentResultTab === 'attention'}}">
        <view class="subtabs"><view class="{{attentionMode === 'sites' ? 'active' : ''}}" data-mode="sites" bindtap="setAttentionMode">关键位点</view><view class="{{attentionMode === 'distribution' ? 'active' : ''}}" data-mode="distribution" bindtap="setAttentionMode">完整分布</view></view>
        <attention-sites wx:if="{{attentionMode === 'sites'}}" sequence="{{currentResult.sequence}}" weights="{{currentResult.attentionWeights}}" modification-names="{{currentResult.modificationNames}}" bindselectsite="onAttentionSite"></attention-sites>
        <view wx:else class="distribution-panel">
          <view class="distribution-controls"><picker mode="selector" range="{{attentionClasses}}" range-key="name" value="{{attentionClassIndex}}" bindchange="onAttentionClass"><view class="class-picker">{{selectedAttentionClass ? selectedAttentionClass.name : '选择修饰类别'}}⌄</view></picker><view class="all-switch"><switch checked="{{!predictedOnly}}" color="#718394" bindchange="toggleAllClasses"></switch><text>全部类别</text></view></view>
          <view wx:if="{{loadingAttention}}" class="inline-loading">正在读取缓存数据…</view>
          <attention-chart wx:elif="{{selectedAttentionClass}}" class-data="{{selectedAttentionClass}}" sequence-length="{{attentionDistribution.sequence_length}}" modeled-start="{{attentionDistribution.modeled_range.start}}" selected-position="{{selectedPosition}}" bindselect="onChartSelect"></attention-chart>
          <empty-state wx:else title="暂无完整注意力数据" description="旧任务可能没有缓存，可重新提交任务生成。"></empty-state>
        </view>
      </view>
      <view wx:elif="{{currentResultTab === 'structure'}}">
        <view class="structure-head"><view><text class="section-title">RNA 二级结构</text><text class="section-desc">注意力 Top 位点已在图中高亮</text></view><button bindtap="openWebView">交互式 3D</button></view>
        <rna-graph graph="{{currentResult.gcn}}" sequence="{{currentResult.sequence}}" highlighted-indices="{{currentResult.highlightedIndices}}" selected-index="{{selectedPosition}}" bindselect="onGraphSelect"></rna-graph>
      </view>
      <view wx:elif="{{currentResultTab === 'interpretability'}}" class="interpretability-panel">
        <view class="subtabs interpretability-tabs"><view class="{{interpretabilityMode === 'integrated-gradients' ? 'active' : ''}}" data-mode="integrated-gradients" bindtap="setInterpretabilityMode">梯度归因</view><view class="{{interpretabilityMode === 'gcn' ? 'active' : ''}}" data-mode="gcn" bindtap="setInterpretabilityMode">GCN 消息传递</view></view>
        <view wx:if="{{interpretabilityMode === 'integrated-gradients'}}">
          <view class="explanation-controls">
            <picker mode="selector" range="{{modificationOptions}}" range-key="name" value="{{igClassIndex}}" bindchange="onIgClassChange"><view class="control-field"><text>目标修饰</text><text>{{modificationOptions[igClassIndex].name}}⌄</text></view></picker>
            <picker mode="selector" range="{{topKOptions}}" value="{{igTopKIndex}}" bindchange="onIgTopKChange"><view class="control-field"><text>关键位点</text><text>Top {{topKOptions[igTopKIndex]}}⌄</text></view></picker>
            <button class="compute-button" loading="{{igLoading}}" disabled="{{igLoading}}" bindtap="runIntegratedGradients">{{igLoading ? '计算中…' : '计算梯度归因'}}</button>
          </view>
          <view wx:if="{{igError}}" class="explanation-error">{{igError}}</view>
          <view wx:if="{{igLoading}}" class="explanation-loading"><view class="spinner small"></view><text>正在执行 Integrated Gradients，可离开本页后稍后查看。</text></view>
          <integrated-gradients wx:elif="{{igResult}}" sequence="{{currentResult.sequence}}" result="{{igResult}}" top-k="{{topKOptions[igTopKIndex]}}" bindselect="onExplanationGraphSelect"></integrated-gradients>
          <empty-state wx:else title="尚未计算梯度归因" description="请选择目标修饰类别，然后开始计算。正、负贡献会分别着色，其他位置保持灰色。"></empty-state>
        </view>
        <view wx:else>
          <view class="explanation-controls">
            <view class="control-field target-input"><text>目标位置（1–{{currentResult.sequenceLength}}）</text><input type="number" value="{{gcnTargetPosition}}" bindinput="onGcnTargetInput"/></view>
            <button class="compute-button" loading="{{gcnLoading}}" disabled="{{gcnLoading}}" bindtap="runGcnMessagePassing">{{gcnLoading ? '计算中…' : '计算消息传递'}}</button>
          </view>
          <view wx:if="{{gcnError}}" class="explanation-error">{{gcnError}}</view>
          <view wx:if="{{gcnLoading}}" class="explanation-loading"><view class="spinner small"></view><text>正在提取 GCN 各层消息。</text></view>
          <gcn-message-passing wx:elif="{{gcnResult}}" sequence="{{currentResult.sequence}}" result="{{gcnResult}}" bindselect="onExplanationGraphSelect"></gcn-message-passing>
          <empty-state wx:else title="尚未计算 GCN 消息传递" description="输入目标碱基位置，查看各 GCN 层向该节点传递的消息强度。"></empty-state>
        </view>
      </view>
    </view>
    <view class="result-bottom-nav safe-bottom"><view wx:for="{{resultTabs}}" wx:key="value" class="bottom-nav-item {{currentResultTab === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="onResultTabTap"><text class="bottom-nav-icon">{{item.icon}}</text><text class="bottom-nav-label">{{item.label}}</text></view></view>
  </block>
</view>
