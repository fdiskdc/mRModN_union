<view class="page-shell results-page">
  <view wx:if="{{isLoading}}" class="loading"><view class="spinner"></view><text>正在加载分析结果…</text></view>
  <error-state wx:elif="{{error}}" message="{{error}}" bindretry="retry"></error-state>
  <block wx:elif="{{currentResult}}">
    <view class="topbar"><view><text class="title">分析结果</text><text class="task-id">批次 {{batchJobId}}</text></view><text class="back" bindtap="backHome">返回</text></view>
    <scroll-view wx:if="{{results.length > 1}}" scroll-x class="sequence-tabs"><view class="sequence-row"><view wx:for="{{results}}" wx:key="jobId" class="sequence-tab {{currentResultIndex === index ? 'active' : ''}}" data-index="{{index}}" bindtap="onSequenceTab"><text>序列 {{index + 1}}</text><text>{{item.sequenceLength}} nt</text></view></view></scroll-view>
    <result-tabs value="{{currentResultTab}}" tabs="{{resultTabs}}" bindchange="onResultTab"></result-tabs>
    <view class="content">
      <result-summary wx:if="{{currentResultTab === 'overview'}}" result="{{currentResult}}" bindopen="onSummaryOpen"></result-summary>
      <classification-tree wx:elif="{{currentResultTab === 'classification'}}" classification="{{currentResult.classification}}"></classification-tree>
      <view wx:elif="{{currentResultTab === 'attention'}}">
        <view class="subtabs"><view class="{{attentionMode === 'sites' ? 'active' : ''}}" data-mode="sites" bindtap="setAttentionMode">关键位点</view><view class="{{attentionMode === 'distribution' ? 'active' : ''}}" data-mode="distribution" bindtap="setAttentionMode">完整分布</view></view>
        <attention-sites wx:if="{{attentionMode === 'sites'}}" sequence="{{currentResult.sequence}}" weights="{{currentResult.attentionWeights}}" modification-names="{{currentResult.modificationNames}}" bindselectsite="onAttentionSite"></attention-sites>
        <view wx:else class="distribution-panel">
          <view class="distribution-controls"><picker mode="selector" range="{{attentionClasses}}" range-key="name" value="{{attentionClassIndex}}" bindchange="onAttentionClass"><view class="class-picker">{{selectedAttentionClass ? selectedAttentionClass.name : '选择修饰类别'}}⌄</view></picker><view class="all-switch"><switch checked="{{!predictedOnly}}" color="#5267D8" bindchange="toggleAllClasses"></switch><text>全部类别</text></view></view>
          <view wx:if="{{loadingAttention}}" class="inline-loading">正在读取缓存数据…</view>
          <attention-chart wx:elif="{{selectedAttentionClass}}" class-data="{{selectedAttentionClass}}" sequence-length="{{attentionDistribution.sequence_length}}" modeled-start="{{attentionDistribution.modeled_range.start}}" selected-position="{{selectedPosition}}" bindselect="onChartSelect"></attention-chart>
          <empty-state wx:else title="暂无完整注意力数据" description="旧任务可能没有缓存，可重新提交任务生成。"></empty-state>
        </view>
      </view>
      <view wx:elif="{{currentResultTab === 'structure'}}">
        <view class="structure-head"><view><text class="section-title">RNA 二级结构</text><text class="section-desc">注意力 Top 位点已在图中高亮</text></view><button bindtap="openWebView">交互式 3D</button></view>
        <rna-graph graph="{{currentResult.gcn}}" sequence="{{currentResult.sequence}}" highlighted-indices="{{currentResult.highlightedIndices}}" selected-index="{{selectedPosition}}" bindselect="onGraphSelect"></rna-graph>
      </view>
    </view>
  </block>
</view>
