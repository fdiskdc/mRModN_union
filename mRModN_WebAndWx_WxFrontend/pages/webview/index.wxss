.webview-state{position:fixed;z-index:9999;top:0;right:0;bottom:0;left:0;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:48rpx;background:linear-gradient(145deg,#F3F1ED 0%,#E4E9EC 100%);box-sizing:border-box}.loading-ring{width:66rpx;height:66rpx;border:8rpx solid rgba(113,131,148,.18);border-top-color:#718394;border-radius:50%;animation:webview-spin .8s linear infinite}.state-title{margin-top:28rpx;color:#39434A;font-size:30rpx;font-weight:800}.state-description{margin-top:12rpx;color:#6F777B;font-size:23rpx;text-align:center;line-height:1.6}.state-card{width:100%;padding:38rpx 30rpx;border:2rpx solid #D8D5CE;border-radius:24rpx;background:#FAF9F6;box-shadow:0 14rpx 40rpx rgba(58,67,70,.12);box-sizing:border-box}.state-card .state-title{margin-top:0}.error-detail{margin-top:20rpx;padding:18rpx;border-radius:12rpx;background:#F2E3E0;color:#985B52;font-size:20rpx;word-break:break-all}.state-actions{display:flex;gap:16rpx;margin-top:28rpx}.state-button{flex:1;padding:20rpx 12rpx;border-radius:14rpx;text-align:center;font-size:24rpx;font-weight:700}.state-button.primary{background:#718394;color:#FEFDFC}.state-button.secondary{background:#E4E9EC;color:#607283}@keyframes webview-spin{to{transform:rotate(360deg)}}
