.webview-state{position:fixed;z-index:9999;top:0;right:0;bottom:0;left:0;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:48rpx;background:linear-gradient(145deg,#F7F8FC 0%,#EEF1FF 100%);box-sizing:border-box}.loading-ring{width:66rpx;height:66rpx;border:8rpx solid rgba(82,103,216,.18);border-top-color:#5267D8;border-radius:50%;animation:webview-spin .8s linear infinite}.state-title{margin-top:28rpx;color:#172033;font-size:30rpx;font-weight:800}.state-description{margin-top:12rpx;color:#7B8394;font-size:23rpx;text-align:center}.state-card{width:100%;padding:38rpx 30rpx;border-radius:24rpx;background:#fff;box-shadow:0 14rpx 40rpx rgba(23,32,51,.12);box-sizing:border-box}.state-card .state-title{margin-top:0}.error-detail{margin-top:20rpx;padding:18rpx;border-radius:12rpx;background:#F7F8FC;color:#9A5360;font-size:20rpx;word-break:break-all}.state-actions{display:flex;gap:16rpx;margin-top:28rpx}.state-button{flex:1;padding:20rpx 12rpx;border-radius:14rpx;text-align:center;font-size:24rpx;font-weight:700}.state-button.primary{background:#5267D8;color:#fff}.state-button.secondary{background:#E9ECF5;color:#586174}@keyframes webview-spin{to{transform:rotate(360deg)}}
