<web-view
  wx:if="{{url}}"
  src="{{url}}"
  bindload="onWebViewLoad"
  binderror="onWebViewError"
  bindmessage="onMessage"
></web-view>
<cover-view wx:if="{{loading}}" class="webview-state loading-state">
  <cover-view class="loading-ring"></cover-view>
  <cover-view class="state-title">Opening Interactive 3D</cover-view>
  <cover-view class="state-description">The first load downloads rendering assets. Please wait.</cover-view>
</cover-view>
<cover-view wx:if="{{error}}" class="webview-state error-state">
  <cover-view class="state-card">
    <cover-view class="state-title">Failed to Load the 3D View</cover-view>
    <cover-view class="state-description">Check the network, web frontend service, and business-domain settings.</cover-view>
    <cover-view class="error-detail">{{error}}</cover-view>
    <cover-view class="state-actions">
      <cover-view class="state-button secondary" bindtap="goBack">Back to 2D Structure</cover-view>
      <cover-view class="state-button primary" bindtap="retry">Reload</cover-view>
    </cover-view>
  </cover-view>
</cover-view>
