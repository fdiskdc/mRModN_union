page{min-height:100%;background:#F5F7FB;color:#172033;font-size:28rpx;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC",sans-serif}button{box-sizing:border-box}button::after{border:0}.page-shell{min-height:100vh;box-sizing:border-box;padding:28rpx 32rpx calc(150rpx + env(safe-area-inset-bottom))}.surface-card{background:#fff;border:2rpx solid #E8EBF2;border-radius:24rpx;box-shadow:0 12rpx 32rpx rgba(23,32,51,.06)}.primary-button{height:92rpx;line-height:92rpx;border-radius:18rpx;background:#5267D8;color:#fff;font-size:30rpx;font-weight:700;box-shadow:0 12rpx 28rpx rgba(82,103,216,.26)}.primary-button[disabled]{background:#B8C0E8;color:#EEF1FF;box-shadow:none}.secondary-button{height:76rpx;line-height:76rpx;border-radius:16rpx;background:#EEF1FF;color:#5267D8;font-size:26rpx}.safe-bottom{padding-bottom:env(safe-area-inset-bottom)}
