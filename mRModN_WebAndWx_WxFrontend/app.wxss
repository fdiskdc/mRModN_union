page {
  min-height: 100%;
  background: #F3F1ED;
  color: #39434A;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", sans-serif;
}
button { box-sizing: border-box; }
button::after { border: 0; }
.page-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 32rpx calc(150rpx + env(safe-area-inset-bottom));
}
.surface-card {
  background: #FAF9F6;
  border: 2rpx solid #D8D5CE;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(58, 67, 70, .06);
}
.primary-button {
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 20rpx;
  background: #718394;
  color: #FEFDFC;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 28rpx rgba(91, 108, 120, .18);
}
.primary-button[disabled] {
  background: #BCC4C8;
  color: #F2F2EF;
  box-shadow: none;
}
.secondary-button {
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 16rpx;
  background: #E4E9EC;
  color: #607283;
  font-size: 26rpx;
}
.safe-bottom { padding-bottom: env(safe-area-inset-bottom); }
