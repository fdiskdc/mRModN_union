.brand-row{display:flex;align-items:center;justify-content:space-between;gap:24rpx;margin-bottom:28rpx}.identity{display:flex;flex-direction:column;min-width:0}.brand{font-size:42rpx;font-weight:800;letter-spacing:1rpx;color:#5267D8}.brand-en{margin-top:2rpx;font-size:20rpx;color:#6C7588;white-space:nowrap}.user{display:flex;align-items:center;gap:12rpx;max-width:260rpx;color:#172033;font-size:24rpx}.user text{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.user image{width:64rpx;height:64rpx;border-radius:50%;background:#EEF1FF;border:2rpx solid #fff;box-shadow:0 6rpx 20rpx rgba(23,32,51,.1)}.login{margin:0;padding:0 28rpx;min-width:112rpx;height:64rpx;line-height:64rpx;border:0;border-radius:32rpx;background:#EEF1FF;color:#5267D8;font-size:26rpx;font-weight:600}.login::after{border:0}.login[disabled]{opacity:.65}
