.brand-row{display:flex;align-items:center;justify-content:space-between;gap:24rpx;margin-bottom:28rpx}.identity{display:flex;flex-direction:column;min-width:0}.brand{font-size:42rpx;font-weight:800;letter-spacing:1rpx;color:#607283}.brand-en{margin-top:2rpx;font-size:20rpx;color:#6F777B;white-space:nowrap}.user{display:flex;align-items:center;gap:12rpx;max-width:260rpx;color:#39434A;font-size:24rpx}.user text{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.user image{width:64rpx;height:64rpx;border-radius:50%;background:#E4E9EC;border:3rpx solid #FAF9F6;box-shadow:0 6rpx 18rpx rgba(58,67,70,.09)}.login{margin:0;padding:0 28rpx;min-width:112rpx;height:64rpx;line-height:64rpx;border:0;border-radius:32rpx;background:#E4E9EC;color:#607283;font-size:26rpx;font-weight:700}.login::after{border:0}.login[disabled]{opacity:.6}
