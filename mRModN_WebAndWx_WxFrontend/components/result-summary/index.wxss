.summary-card{position:relative;overflow:hidden;padding:36rpx;border:2rpx solid rgba(255,255,255,.16);border-radius:28rpx;color:#FEFDFC;background:linear-gradient(140deg,#667A89 0%,#718394 58%,#7E8F8B 100%);box-shadow:0 18rpx 38rpx rgba(74,88,94,.16)}.summary-card::after{content:"";position:absolute;right:-70rpx;top:-100rpx;width:250rpx;height:250rpx;border-radius:50%;background:rgba(255,255,255,.06)}.eyebrow{font-size:22rpx;opacity:.82;letter-spacing:2rpx}.title{position:relative;z-index:1;display:block;font-size:36rpx;font-weight:800;margin:9rpx 0}.sequence{position:relative;z-index:1;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-family:monospace;opacity:.84}.stats{position:relative;z-index:1;display:flex;justify-content:space-around;margin-top:32rpx;padding:22rpx 0;border-top:1rpx solid rgba(255,255,255,.14);border-bottom:1rpx solid rgba(255,255,255,.14)}.stats view{text-align:center}.num,.label{display:block}.num{font-size:34rpx;font-weight:800}.label{font-size:21rpx;opacity:.76;margin-top:4rpx}.top-result{position:relative;z-index:1;display:flex;justify-content:space-between;align-items:center;margin-top:22rpx;padding:18rpx 20rpx;border:1rpx solid rgba(255,255,255,.16);border-radius:16rpx;background:rgba(255,255,255,.10);color:#F3F1ED;font-size:24rpx}.top-result b{color:#FEFDFC;font-size:26rpx}
