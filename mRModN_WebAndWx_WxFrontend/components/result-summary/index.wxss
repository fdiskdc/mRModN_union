.summary-card{padding:34rpx;border-radius:26rpx;color:#fff;background:linear-gradient(135deg,#5267D8,#6F82E7 58%,#28A69A);box-shadow:0 18rpx 42rpx rgba(82,103,216,.24)}.eyebrow{font-size:22rpx;opacity:.85}.title{display:block;font-size:36rpx;font-weight:800;margin:8rpx 0}.sequence{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-family:monospace;opacity:.85}.stats{display:flex;justify-content:space-around;margin-top:32rpx}.stats view{text-align:center}.num,.label{display:block}.num{font-size:34rpx;font-weight:800}.label{font-size:21rpx;opacity:.8;margin-top:4rpx}
.top-result{display:flex;justify-content:space-between;align-items:center;margin-top:22rpx;padding:18rpx 20rpx;border-radius:16rpx;background:#EEF1FF;color:#6C7588;font-size:24rpx}.top-result b{color:#5267D8;font-size:26rpx}
