<view class="summary-card"><text class="eyebrow">分析完成</text><text class="title">序列 {{result.displayIndex}} 概览</text><text class="sequence">{{result.sequencePreview}}</text><view class="stats"><view><text class="num">{{result.sequenceLength}}</text><text class="label">核苷酸</text></view><view><text class="num">{{result.predictedCount}}</text><text class="label">预测修饰</text></view><view><text class="num">{{result.edgeCount}}</text><text class="label">结构连边</text></view></view><view class="top-result"><text>最高概率类别</text><b>{{result.topModification}}</b></view></view>
<view class="quick-grid"><view class="quick" data-tab="classification" bindtap="open"><text class="icon">✓</text><text>分类结果</text></view><view class="quick" data-tab="attention" bindtap="open"><text class="icon">⌁</text><text>注意力</text></view><view class="quick" data-tab="structure" bindtap="open"><text class="icon">◎</text><text>RNA 结构</text></view></view>
