.card{background:#fff;border:2rpx solid #E8EBF2;border-radius:24rpx;padding:24rpx}.header{display:flex;justify-content:space-between;align-items:center;margin-bottom:12rpx}.title,.meta{display:block}.title{font-size:29rpx;font-weight:800;color:#172033}.meta{font-size:22rpx;color:#6C7588;margin-top:6rpx}.badge{font-size:21rpx;padding:10rpx 14rpx;border-radius:999rpx;background:#EDF8F3;color:#23805A}.legend{display:flex;align-items:center;gap:8rpx;color:#7B8394;font-size:20rpx}.legend-dot{width:16rpx;height:16rpx;border-radius:50%}.key-dot{background:#5267D8;box-shadow:0 0 0 4rpx rgba(82,103,216,.16)}.muted-dot{margin-left:14rpx;background:#A6ACB8}.canvas{width:100%;height:420rpx}
