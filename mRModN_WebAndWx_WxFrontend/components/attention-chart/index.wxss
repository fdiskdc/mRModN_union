.card{background:#FAF9F6;border:2rpx solid #D8D5CE;border-radius:24rpx;padding:24rpx;box-shadow:0 8rpx 24rpx rgba(58,67,70,.05)}.header{display:flex;justify-content:space-between;align-items:center;margin-bottom:12rpx}.title,.meta{display:block}.title{font-size:29rpx;font-weight:800;color:#39434A}.meta{font-size:22rpx;color:#6F777B;margin-top:6rpx}.badge{font-size:21rpx;padding:10rpx 14rpx;border-radius:999rpx}.badge.positive{background:#E5ECE7;color:#657D6C}.badge.muted{background:#EEEDE9;color:#858B89}.legend{display:flex;align-items:center;gap:8rpx;color:#737B7B;font-size:20rpx}.legend-dot{width:16rpx;height:16rpx;border-radius:50%}.key-dot{background:#B27C6C;box-shadow:0 0 0 4rpx rgba(178,124,108,.14)}.muted-dot{margin-left:14rpx;background:#A9ACA8}.canvas{width:100%;height:420rpx}
