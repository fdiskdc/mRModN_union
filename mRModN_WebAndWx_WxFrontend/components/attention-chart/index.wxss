.card{background:#fff;border:2rpx solid #E8EBF2;border-radius:24rpx;padding:24rpx}.header{display:flex;justify-content:space-between;align-items:center;margin-bottom:16rpx}.title,.meta{display:block}.title{font-size:29rpx;font-weight:800;color:#172033}.meta{font-size:22rpx;color:#6C7588;margin-top:6rpx}.badge{font-size:21rpx;padding:10rpx 14rpx;border-radius:999rpx;background:#EDF8F3;color:#23805A}.canvas{width:100%;height:420rpx}
