<view class="card">
  <view wx:if="{{classData}}" class="header">
    <view><text class="title">{{classData.name}} Full Distribution</text><text class="meta">Probability {{classData.probabilityText}}</text></view>
    <text class="badge {{classData.is_predicted ? 'positive' : 'muted'}}">{{classData.is_predicted ? 'Predicted positive' : 'Not detected'}}</text>
  </view>
  <view class="legend"><view class="legend-dot key-dot"></view><text>Top 5 Key Sites</text><view class="legend-dot muted-dot"></view><text>Other Sites</text></view>
  <canvas type="2d" id="attentionCanvas" class="canvas" bindtap="onTap"></canvas>
</view>
