.card{background:#fff;border:2rpx solid #E8EBF2;border-radius:24rpx;padding:28rpx;box-shadow:0 12rpx 32rpx rgba(23,32,51,.06);transition:.2s}.card.focused{border-color:#5267D8;box-shadow:0 12rpx 36rpx rgba(82,103,216,.14)}.header,.meta{display:flex;align-items:center;justify-content:space-between}.label{font-size:30rpx;font-weight:700;color:#172033}.length{margin-left:16rpx;color:#5267D8;font-size:24rpx}.remove{color:#D95B62;font-size:24rpx}.input{width:100%;height:220rpx;box-sizing:border-box;margin:22rpx 0 16rpx;padding:20rpx;border-radius:16rpx;background:#F7F8FC;color:#172033;font-family:monospace;font-size:26rpx;line-height:1.55}.meta{color:#6C7588;font-size:22rpx}.status.valid{color:#35A36F}
