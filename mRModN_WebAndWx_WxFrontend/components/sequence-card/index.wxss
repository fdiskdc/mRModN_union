.card{background:#FAF9F6;border:2rpx solid #D8D5CE;border-radius:24rpx;padding:28rpx;box-shadow:0 8rpx 24rpx rgba(58,67,70,.06);transition:.2s}.card.focused{border-color:#718394;box-shadow:0 10rpx 28rpx rgba(91,108,120,.14)}.header,.meta{display:flex;align-items:center;justify-content:space-between}.label{font-size:30rpx;font-weight:700;color:#39434A}.length{margin-left:16rpx;color:#607283;font-size:24rpx}.remove{color:#A8665D;font-size:24rpx}.input{width:100%;height:220rpx;box-sizing:border-box;margin:22rpx 0 16rpx;padding:20rpx;border:2rpx solid transparent;border-radius:16rpx;background:#EEEDE9;color:#39434A;font-family:monospace;font-size:26rpx;line-height:1.55}.card.focused .input{background:#F4F3EF;border-color:#C8D0D4}.meta{color:#6F777B;font-size:22rpx}.status.valid{color:#657D6C}
