.card{background:#fff;border-radius:24rpx;padding:28rpx;border:2rpx solid #E8EBF2}.heading,.group-title,.mod{display:flex;justify-content:space-between;align-items:center}.heading{font-size:32rpx;font-weight:800;color:#172033;margin-bottom:24rpx}.heading>view{display:flex;flex-direction:column}.count{font-size:24rpx;font-weight:500;color:#6C7588;margin-top:6rpx}.legend{font-size:22rpx;font-weight:400;color:#6C7588}.legend i{display:inline-block;width:16rpx;height:16rpx;border-radius:50%;background:#35A36F;margin-right:8rpx}.empty{padding:28rpx;background:#F7F8FC;border-radius:16rpx;color:#6C7588;font-size:25rpx;line-height:1.6}.group{margin-top:18rpx}.group-title{padding:20rpx;border-radius:16rpx;background:#F7F8FC;color:#6C7588;font-weight:700}.group-title.active{background:#EDF8F3;color:#23805A}.mods{display:flex;flex-direction:column;gap:12rpx;margin-top:12rpx}.mod{padding:18rpx;border-radius:14rpx;border:2rpx solid #E8EBF2;color:#6C7588}.mod>view{display:flex;align-items:baseline;gap:16rpx}.mod-name{font-weight:700;color:#172033}.probability{font-size:24rpx}.state{font-size:23rpx}.mod.active{border-color:#9ED5BC;background:#F4FBF7;color:#23805A}.toggle{margin-top:24rpx;height:72rpx;line-height:72rpx;border-radius:36rpx;background:#EEF1FF;color:#5267D8;font-size:25rpx;font-weight:700}.toggle::after{border:0}
