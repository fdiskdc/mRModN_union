.card{background:#FAF9F6;border-radius:24rpx;padding:28rpx;border:2rpx solid #D8D5CE;box-shadow:0 8rpx 24rpx rgba(58,67,70,.05)}.heading,.group-title,.mod{display:flex;justify-content:space-between;align-items:center}.heading{font-size:32rpx;font-weight:800;color:#39434A;margin-bottom:24rpx}.heading>view{display:flex;flex-direction:column}.count{font-size:24rpx;font-weight:500;color:#6F777B;margin-top:6rpx}.legend{font-size:22rpx;font-weight:400;color:#6F777B}.legend i{display:inline-block;width:16rpx;height:16rpx;border-radius:50%;background:#728B7B;margin-right:8rpx;box-shadow:0 0 0 4rpx rgba(114,139,123,.12)}.empty{padding:28rpx;background:#EEEDE9;border-radius:16rpx;color:#6F777B;font-size:25rpx;line-height:1.6}.group{margin-top:18rpx}.group-title{padding:21rpx;border:2rpx solid transparent;border-radius:16rpx;color:#596265;font-weight:700}.group-title.base-a{background:#F0E4E2;border-color:#E4CFCC;color:#855F5C}.group-title.base-c{background:#E3E9ED;border-color:#CDD8DF;color:#5B7282}.group-title.base-g{background:#E5ECE7;border-color:#CFDCCF;color:#5D735F}.group-title.base-u{background:#EEE8DB;border-color:#E0D5BD;color:#7C6B49}.group-title.active{box-shadow:inset 6rpx 0 #728B7B}.mods{display:flex;flex-direction:column;gap:12rpx;margin-top:12rpx}.mod{padding:18rpx;border-radius:14rpx;border:2rpx solid #DDDAD3;background:#FDFCF9;color:#7B8282}.mod>view{display:flex;align-items:baseline;gap:16rpx}.mod-name{font-weight:700;color:#39434A}.probability{font-size:24rpx}.state{font-size:23rpx;color:#8D9291}.mod.active{border-color:#9CAF9F;background:#E8EEE9;color:#657D6C}.mod.active .state,.mod.active .mod-name{color:#526C5A}
