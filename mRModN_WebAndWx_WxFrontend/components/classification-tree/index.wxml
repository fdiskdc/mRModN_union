<view class="card">
  <view class="heading">
    <view>
      <text>Modification Classification</text>
      <text class="count">{{positiveCount}} modifications detected · 12 total</text>
    </view>
    <text class="legend"><i></i>Predicted positive</text>
  </view>
  <view wx:if="{{!groups.length}}" class="empty">No classification results</view>
  <view wx:for="{{groups}}" wx:key="name" class="group">
    <view class="group-title base-{{item.baseTone}} {{item.isPredicted ? 'active' : ''}}">
      <text>{{item.name}}</text>
      <text>{{item.probabilityText}}</text>
    </view>
    <view class="mods">
      <view wx:for="{{item.children}}" wx:for-item="mod" wx:key="name" class="mod {{mod.isPredicted ? 'active' : ''}}">
        <view>
          <text class="mod-name">{{mod.name}}</text>
          <text class="probability">{{mod.probabilityText}}</text>
        </view>
        <text class="state">{{mod.isPredicted ? 'Detected ✓' : 'Not detected'}}</text>
      </view>
    </view>
  </view>
</view>
