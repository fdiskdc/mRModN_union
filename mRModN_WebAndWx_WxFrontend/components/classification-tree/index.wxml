<view class="card">
  <view class="heading">
    <view>
      <text>修饰分类</text>
      <text class="count">检出 {{positiveCount}} 类修饰 · 共 12 类</text>
    </view>
    <text class="legend"><i></i>预测阳性</text>
  </view>
  <view wx:if="{{!groups.length}}" class="empty">暂无分类结果</view>
  <view wx:for="{{groups}}" wx:key="name" class="group">
    <view class="group-title {{item.isPredicted ? 'active' : ''}}">
      <text>{{item.name}}</text>
      <text>{{item.probabilityText}}</text>
    </view>
    <view class="mods">
      <view wx:for="{{item.children}}" wx:for-item="mod" wx:key="name" class="mod {{mod.isPredicted ? 'active' : ''}}">
        <view>
          <text class="mod-name">{{mod.name}}</text>
          <text class="probability">{{mod.probabilityText}}</text>
        </view>
        <text class="state">{{mod.isPredicted ? '已检出 ✓' : '未检出'}}</text>
      </view>
    </view>
  </view>
</view>
