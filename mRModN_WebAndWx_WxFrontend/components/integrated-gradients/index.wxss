.ig-root{display:flex;flex-direction:column;gap:20rpx}.legend{display:flex;flex-wrap:wrap;gap:20rpx;color:#697386;font-size:22rpx}.legend view{display:flex;align-items:center;gap:8rpx}.dot{width:18rpx;height:18rpx;border-radius:50%}.dot.positive{background:#E36B50}.dot.negative{background:#4C78C8}.dot.muted{background:#C9CFDA}.sequence-card,.ranking,.selected-info{background:#fff;border:2rpx solid #E5E8F0;border-radius:24rpx;padding:22rpx}.sequence-grid{display:grid;grid-template-columns:repeat(10,minmax(0,1fr));gap:7rpx}.site{min-width:0;border:2rpx solid #DDE2EA;border-radius:12rpx;background:#F1F3F6;text-align:center;padding:8rpx 2rpx;color:#8A92A2}.site.positive{border-color:#E36B50;background:#FFF0EC;color:#B7432E}.site.negative{border-color:#4C78C8;background:#EDF4FF;color:#285DA8}.site.selected{box-shadow:0 0 0 5rpx rgba(82,103,216,.18)}.position,.base,.score{display:block;white-space:nowrap;overflow:hidden}.position{font-size:18rpx}.base{font-size:30rpx;line-height:1.25;font-weight:900}.score{font-size:16rpx}.pager{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:16rpx;margin-top:20rpx;color:#778094;font-size:20rpx}.pager button{margin:0;height:66rpx;line-height:66rpx;background:#5267D8;color:#fff;border-radius:14rpx;font-size:23rpx}.pager button[disabled]{background:#E4E7ED;color:#A4ABBA}.selected-info{display:flex;justify-content:space-between;gap:12rpx;font-size:23rpx}.selected-info .positive,.rank-score.positive{color:#C34A34}.selected-info .negative,.rank-score.negative{color:#3267B5}.block-title{font-size:28rpx;font-weight:800;color:#172033}.rank-row{display:grid;grid-template-columns:50rpx 1fr auto;gap:12rpx;padding:15rpx 0;border-bottom:1rpx solid #EDF0F5}.rank-row:last-child{border-bottom:0}.rank{width:40rpx;height:40rpx;line-height:40rpx;text-align:center;border-radius:50%;background:#EEF1FF;color:#5267D8;font-weight:800}.rank-base{font-weight:700}.rank-score{font-family:monospace;font-weight:700}.graph-title{display:flex;align-items:flex-end;justify-content:space-between;color:#778094;font-size:20rpx}
