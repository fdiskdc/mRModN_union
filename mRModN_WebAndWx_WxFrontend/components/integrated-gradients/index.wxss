.ig-root{display:flex;flex-direction:column;gap:20rpx}.legend{display:flex;flex-wrap:wrap;gap:20rpx;color:#6F777B;font-size:22rpx}.legend view{display:flex;align-items:center;gap:8rpx}.dot{width:18rpx;height:18rpx;border-radius:50%}.dot.positive{background:#B27C6C}.dot.negative{background:#70859B}.dot.muted{background:#C8C8C3}.sequence-card,.ranking,.selected-info{background:#FAF9F6;border:2rpx solid #D8D5CE;border-radius:24rpx;padding:22rpx;box-shadow:0 8rpx 24rpx rgba(58,67,70,.05)}.sequence-grid{display:grid;grid-template-columns:repeat(10,minmax(0,1fr));gap:7rpx}.site{min-width:0;border:2rpx solid #D6D4CE;border-radius:12rpx;background:#E9E8E3;text-align:center;padding:8rpx 2rpx;color:#858B89}.site.positive{border-color:#C49182;background:#F0E2DD;color:#87584D}.site.negative{border-color:#8FA1AF;background:#E3E8EC;color:#526A7E}.site.selected{box-shadow:0 0 0 5rpx rgba(178,124,108,.20)}.position,.base,.score{display:block;white-space:nowrap;overflow:hidden}.position{font-size:18rpx}.base{font-size:30rpx;line-height:1.25;font-weight:900}.score{font-size:16rpx}.pager{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:16rpx;margin-top:20rpx;color:#6F777B;font-size:20rpx}.pager button{margin:0;height:66rpx;line-height:66rpx;background:#718394;color:#FEFDFC;border-radius:14rpx;font-size:23rpx}.pager button[disabled]{background:#E2E1DC;color:#979B9B}.selected-info{display:flex;justify-content:space-between;gap:12rpx;font-size:23rpx}.selected-info .positive,.rank-score.positive{color:#986355}.selected-info .negative,.rank-score.negative{color:#526A7E}.block-title{font-size:28rpx;font-weight:800;color:#39434A}.rank-row{display:grid;grid-template-columns:50rpx 1fr auto;gap:12rpx;padding:15rpx 0;border-bottom:1rpx solid #E7E3DD}.rank-row:last-child{border-bottom:0}.rank{width:40rpx;height:40rpx;line-height:40rpx;text-align:center;border-radius:50%;background:#E4E9EC;color:#607283;font-weight:800}.rank-base{font-weight:700;color:#39434A}.rank-score{font-family:monospace;font-weight:700}.graph-title{display:flex;align-items:flex-end;justify-content:space-between;color:#6F777B;font-size:20rpx}
