<view class="card"><view class="heading"><text>关键位点</text><text wx:if="{{sites.length}}">{{siteIndex + 1}} / {{sites.length}}</text></view><view class="controls"><picker mode="selector" range="{{modificationNames}}" value="{{selectedPickerIndex}}" bindchange="onModification"><view class="picker">{{selectedName || '暂无阳性类别'}}⌄</view></picker><view class="top">Top <input type="number" value="{{topX}}" bindblur="onTopX"/></view></view><block wx:if="{{sites.length}}"><view class="score"><text>位置 {{sites[siteIndex].index + 1}}</text><text>{{sites[siteIndex].scoreText}}</text></view><scroll-view scroll-x class="sequence"><view class="letters"><view wx:for="{{viewport}}" wx:key="index" class="base {{item.active ? 'active' : ''}}" style="border-color:{{item.color}}"><text>{{item.base}}</text><text class="pos">{{item.position}}</text></view></view></scroll-view><view class="nav"><button disabled="{{siteIndex <= 0}}" bindtap="prev">上一个</button><button disabled="{{siteIndex >= sites.length - 1}}" bindtap="next">下一个</button></view></block><empty-state wx:else title="暂无关键位点" description="当前类别没有可展示的注意力位点"></empty-state></view>
