<view class="card">
  <view class="heading">
    <text>关键位点</text>
    <text wx:if="{{sites.length}}">{{siteIndex + 1}} / {{sites.length}}</text>
  </view>
  <view class="controls">
    <picker mode="selector" range="{{modificationNames}}" value="{{selectedPickerIndex}}" bindchange="onModification">
      <view class="picker">{{selectedName || '暂无阳性类别'}}⌄</view>
    </picker>
    <view class="top">Top <input type="number" value="{{topX}}" bindblur="onTopX"/></view>
  </view>
  <block wx:if="{{sites.length}}">
    <view class="score">
      <view>
        <text class="score-label">当前关键位点 · Top {{sites[siteIndex].rank}}</text>
        <text>位置 {{sites[siteIndex].index + 1}}</text>
      </view>
      <text>{{sites[siteIndex].scoreText}}</text>
    </view>

    <view class="sequence-heading">
      <view>
        <text class="sequence-title">RNA 序列</text>
        <text class="sequence-desc">Top 位点紫色高亮，其他位点灰色；可左右滑动</text>
      </view>
      <view class="legend">
        <view class="legend-dot key-dot"></view><text>关键</text>
        <view class="legend-dot muted-dot"></view><text>其他</text>
      </view>
    </view>

    <scroll-view
      class="sequence-scroll"
      scroll-x
      enhanced
      show-scrollbar="{{false}}"
      scroll-with-animation
      scroll-into-view="{{activeAnchor}}"
    >
      <view class="sequence-row">
        <view class="sequence-spacer"></view>
        <view
          wx:for="{{sequenceRow}}"
          wx:key="index"
          id="sequence-position-{{item.index}}"
          class="sequence-position {{item.keyRank ? 'key' : 'muted'}} {{item.active ? 'active' : ''}}"
          data-rank="{{item.keyRank}}"
          bindtap="onSequencePositionTap"
        >
          <text class="position-label">{{item.position}}</text>
          <view class="base-box">
            <text class="base-letter">{{item.base}}</text>
            <text wx:if="{{item.keyRank}}" class="rank">Top {{item.keyRank}}</text>
          </view>
        </view>
        <view class="sequence-spacer"></view>
      </view>
    </scroll-view>

    <view class="nav">
      <button disabled="{{siteIndex <= 0}}" bindtap="prev">← 上一个关键位点</button>
      <button disabled="{{siteIndex >= sites.length - 1}}" bindtap="next">下一个关键位点 →</button>
    </view>
  </block>
  <empty-state wx:else title="暂无关键位点" description="当前类别没有可展示的注意力位点"></empty-state>
</view>
