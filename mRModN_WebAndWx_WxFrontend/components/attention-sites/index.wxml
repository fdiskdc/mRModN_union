<view class="card">
  <view class="heading">
    <text>Key Sites</text>
    <text wx:if="{{sites.length}}">{{siteIndex + 1}} / {{sites.length}}</text>
  </view>
  <view class="controls">
    <picker mode="selector" range="{{modificationNames}}" value="{{selectedPickerIndex}}" bindchange="onModification">
      <view class="picker">{{selectedName || 'No positive class'}}⌄</view>
    </picker>
    <view class="top">Top <input type="number" value="{{topX}}" bindblur="onTopX"/></view>
  </view>
  <block wx:if="{{sites.length}}">
    <view class="score">
      <view>
        <text class="score-label">Current Key Site · Top {{sites[siteIndex].rank}}</text>
        <text>Position {{sites[siteIndex].index + 1}}</text>
      </view>
      <text>{{sites[siteIndex].scoreText}}</text>
    </view>

    <view class="sequence-heading">
      <view>
        <text class="sequence-title">RNA Sequence</text>
        <text class="sequence-desc">Top sites are highlighted in terracotta; other sites remain gray. Swipe horizontally.</text>
      </view>
      <view class="legend">
        <view class="legend-dot key-dot"></view><text>Key</text>
        <view class="legend-dot muted-dot"></view><text>Other</text>
      </view>
    </view>

    <scroll-view
      class="sequence-scroll"
      scroll-x
      enhanced
      show-scrollbar="{{false}}"
      scroll-with-animation
      scroll-into-view="{{activeAnchor}}"
    >
      <view class="sequence-row">
        <view class="sequence-spacer"></view>
        <view
          wx:for="{{sequenceRow}}"
          wx:key="index"
          id="sequence-position-{{item.index}}"
          class="sequence-position {{item.keyRank ? 'key' : 'muted'}} {{item.active ? 'active' : ''}}"
          data-rank="{{item.keyRank}}"
          bindtap="onSequencePositionTap"
        >
          <text class="position-label">{{item.position}}</text>
          <view class="base-box">
            <text class="base-letter">{{item.base}}</text>
            <text wx:if="{{item.keyRank}}" class="rank">Top {{item.keyRank}}</text>
          </view>
        </view>
        <view class="sequence-spacer"></view>
      </view>
    </scroll-view>

    <view class="nav">
      <button disabled="{{siteIndex <= 0}}" bindtap="prev">← Previous</button>
      <button disabled="{{siteIndex >= sites.length - 1}}" bindtap="next">Next →</button>
    </view>
  </block>
  <empty-state wx:else title="No Key Sites" description="No attention sites are available for this class."></empty-state>
</view>
