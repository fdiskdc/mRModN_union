.card{background:#fff;border:2rpx solid #E8EBF2;border-radius:24rpx;padding:28rpx}.heading,.controls,.score,.nav,.sequence-heading{display:flex;align-items:center;justify-content:space-between}.heading{font-size:30rpx;font-weight:800;color:#172033}.heading text:last-child{color:#5267D8;font-size:24rpx}.controls{gap:16rpx;margin:22rpx 0}.picker,.top{background:#F7F8FC;border-radius:14rpx;padding:18rpx 20rpx;color:#172033}.picker{min-width:260rpx}.top{display:flex;align-items:center}.top input{width:70rpx;text-align:center;margin-left:8rpx}.score{padding:18rpx;border-radius:16rpx;background:#EEF1FF;color:#5267D8;font-weight:700}.score>view{display:flex;flex-direction:column;gap:4rpx}.score-label{font-size:20rpx;color:#7888DB}.sequence-heading{align-items:flex-end;margin:28rpx 0 16rpx}.sequence-title,.sequence-desc{display:block}.sequence-title{font-size:26rpx;font-weight:800;color:#172033}.sequence-desc{font-size:20rpx;color:#858D9D;margin-top:5rpx}.legend{display:flex;align-items:center;gap:7rpx;color:#7B8394;font-size:19rpx}.legend-dot{width:16rpx;height:16rpx;border-radius:4rpx}.key-dot{background:#5267D8;box-shadow:0 0 0 4rpx rgba(82,103,216,.16)}.muted-dot{margin-left:10rpx;background:#D8DCE4}.sequence-scroll{width:100%;border-radius:18rpx;background:#F7F8FA;border:2rpx solid #E7E9EF}.sequence-row{display:inline-flex;align-items:flex-start;gap:10rpx;min-width:100%;padding:18rpx 0 22rpx}.sequence-spacer{flex:none;width:238rpx;height:1rpx}.sequence-position{position:relative;flex:none;width:66rpx;text-align:center}.position-label{display:block;height:32rpx;font-size:18rpx;line-height:28rpx;color:#8C94A5}.base-box{position:relative;display:flex;align-items:center;justify-content:center;width:66rpx;height:66rpx;border-radius:12rpx;transition:transform .18s ease}.sequence-position.muted .base-box{background:#DDE0E6;border:2rpx solid #D3D7DF;color:#8F96A3}.sequence-position.key .base-box{background:#5267D8;border:2rpx solid #5267D8;color:#fff;font-weight:900;box-shadow:0 6rpx 16rpx rgba(82,103,216,.25)}.sequence-position.key .position-label{color:#5267D8;font-weight:800}.sequence-position.active .base-box{z-index:3;background:#172033;border-color:#172033;transform:scale(1.14);box-shadow:0 8rpx 22rpx rgba(23,32,51,.42),0 0 0 6rpx rgba(82,103,216,.24)}.sequence-position.active .position-label{color:#172033;font-weight:900}.base-letter{font-size:28rpx;line-height:1;font-weight:800}.rank{position:absolute;left:50%;bottom:-24rpx;transform:translateX(-50%);white-space:nowrap;padding:2rpx 7rpx;border-radius:8rpx;background:#fff;color:#5267D8;font-size:15rpx;line-height:20rpx;box-shadow:0 2rpx 7rpx rgba(23,32,51,.2)}.sequence-position.active .rank{color:#172033}.nav{gap:16rpx;margin-top:24rpx}.nav button{flex:1;margin:0;padding:0 8rpx;font-size:23rpx;border-radius:14rpx;background:#5267D8;color:#fff}.nav button[disabled]{background:#E8EBF2;color:#9AA1B1}
