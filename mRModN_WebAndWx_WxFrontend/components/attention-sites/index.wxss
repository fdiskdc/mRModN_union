.card{background:#fff;border:2rpx solid #E8EBF2;border-radius:24rpx;padding:28rpx}.heading,.controls,.score,.nav{display:flex;align-items:center;justify-content:space-between}.heading{font-size:30rpx;font-weight:800;color:#172033}.heading text:last-child{color:#5267D8;font-size:24rpx}.controls{gap:16rpx;margin:22rpx 0}.picker,.top{background:#F7F8FC;border-radius:14rpx;padding:18rpx 20rpx;color:#172033}.picker{min-width:260rpx}.top{display:flex;align-items:center}.top input{width:70rpx;text-align:center;margin-left:8rpx}.score{padding:18rpx;border-radius:16rpx;background:#EEF1FF;color:#5267D8;font-weight:700}.sequence{margin:22rpx 0;white-space:nowrap}.letters{display:flex;gap:8rpx}.base{flex:none;width:58rpx;padding:12rpx 0;text-align:center;border:3rpx solid;border-radius:12rpx;background:#fff}.base.active{background:#172033;color:#fff;transform:translateY(-4rpx)}.pos{display:block;font-size:18rpx;margin-top:4rpx;opacity:.7}.nav button{width:46%;font-size:25rpx;border-radius:14rpx;background:#5267D8;color:#fff}.nav button[disabled]{background:#E8EBF2;color:#9AA1B1}
