.card{background:#FAF9F6;border:2rpx solid #D8D5CE;border-radius:24rpx;padding:28rpx;box-shadow:0 8rpx 24rpx rgba(58,67,70,.05)}.heading,.controls,.score,.nav,.sequence-heading{display:flex;align-items:center;justify-content:space-between}.heading{font-size:30rpx;font-weight:800;color:#39434A}.heading text:last-child{color:#A06F62;font-size:24rpx}.controls{gap:16rpx;margin:22rpx 0}.picker,.top{background:#EEEDE9;border:1rpx solid #E0DDD6;border-radius:14rpx;padding:18rpx 20rpx;color:#39434A}.picker{min-width:260rpx}.top{display:flex;align-items:center;color:#6F777B}.top input{width:70rpx;text-align:center;margin-left:8rpx;color:#39434A;font-weight:700}.score{padding:20rpx;border:2rpx solid #E2CFC9;border-radius:16rpx;background:#F0E2DD;color:#87584D;font-weight:700}.score>view{display:flex;flex-direction:column;gap:4rpx}.score-label{font-size:20rpx;color:#9B685B}.sequence-heading{align-items:flex-end;margin:28rpx 0 16rpx}.sequence-title,.sequence-desc{display:block}.sequence-title{font-size:26rpx;font-weight:800;color:#39434A}.sequence-desc{font-size:20rpx;color:#777F7F;margin-top:5rpx}.legend{display:flex;align-items:center;gap:7rpx;color:#737B7B;font-size:19rpx}.legend-dot{width:16rpx;height:16rpx;border-radius:4rpx}.key-dot{background:#B27C6C;box-shadow:0 0 0 4rpx rgba(178,124,108,.14)}.muted-dot{margin-left:10rpx;background:#D2D1CC}.sequence-scroll{width:100%;border-radius:18rpx;background:#EEEDE9;border:2rpx solid #DDDAD3}.sequence-row{display:inline-flex;align-items:flex-start;gap:10rpx;min-width:100%;padding:18rpx 0 22rpx}.sequence-spacer{flex:none;width:238rpx;height:1rpx}.sequence-position{position:relative;flex:none;width:66rpx;text-align:center}.position-label{display:block;height:32rpx;font-size:18rpx;line-height:28rpx;color:#8D9291}.base-box{position:relative;display:flex;align-items:center;justify-content:center;width:66rpx;height:66rpx;border-radius:12rpx;transition:transform .18s ease}.sequence-position.muted .base-box{background:#E2E1DC;border:2rpx solid #D3D2CD;color:#858A89}.sequence-position.key .base-box{background:#B27C6C;border:2rpx solid #A86E5E;color:#FEFDFC;font-weight:900;box-shadow:0 6rpx 16rpx rgba(178,124,108,.20)}.sequence-position.key .position-label{color:#9B685B;font-weight:800}.sequence-position.active .base-box{z-index:3;background:#87584D;border-color:#754A41;transform:scale(1.14);box-shadow:0 8rpx 22rpx rgba(117,74,65,.28),0 0 0 6rpx rgba(178,124,108,.22)}.sequence-position.active .position-label{color:#754A41;font-weight:900}.base-letter{font-size:28rpx;line-height:1;font-weight:800}.rank{position:absolute;left:50%;bottom:-24rpx;transform:translateX(-50%);white-space:nowrap;padding:2rpx 7rpx;border-radius:8rpx;background:#FAF9F6;color:#9B685B;font-size:15rpx;line-height:20rpx;box-shadow:0 2rpx 7rpx rgba(58,67,70,.14)}.sequence-position.active .rank{color:#754A41}.nav{gap:16rpx;margin-top:24rpx}.nav button{flex:1;margin:0;padding:0 8rpx;font-size:23rpx;border-radius:14rpx;background:#718394;color:#FEFDFC;box-shadow:0 6rpx 16rpx rgba(91,108,120,.12)}.nav button[disabled]{background:#E2E1DC;color:#979B9B;box-shadow:none}
