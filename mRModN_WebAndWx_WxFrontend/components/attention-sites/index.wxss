.card{background:#fff;border:2rpx solid #E8EBF2;border-radius:24rpx;padding:28rpx}.heading,.controls,.score,.nav,.map-heading{display:flex;align-items:center;justify-content:space-between}.heading{font-size:30rpx;font-weight:800;color:#172033}.heading text:last-child{color:#5267D8;font-size:24rpx}.controls{gap:16rpx;margin:22rpx 0}.picker,.top{background:#F7F8FC;border-radius:14rpx;padding:18rpx 20rpx;color:#172033}.picker{min-width:260rpx}.top{display:flex;align-items:center}.top input{width:70rpx;text-align:center;margin-left:8rpx}.site-strip{white-space:nowrap;margin-bottom:18rpx}.site-row{display:flex;gap:12rpx}.site-chip{flex:none;display:flex;flex-direction:column;gap:4rpx;padding:14rpx 18rpx;border-radius:14rpx;background:#ECEEF2;color:#858D9D;border:2rpx solid #D9DDE5;font-size:21rpx}.site-chip text:first-child{font-weight:800}.site-chip.active{background:#5267D8;color:#fff;border-color:#5267D8;box-shadow:0 8rpx 20rpx rgba(82,103,216,.3)}.score{padding:18rpx;border-radius:16rpx;background:#EEF1FF;color:#5267D8;font-weight:700}.score>view{display:flex;flex-direction:column;gap:4rpx}.score-label{font-size:20rpx;color:#7888DB}.map-heading{align-items:flex-end;margin:28rpx 0 16rpx}.map-title,.map-desc{display:block}.map-title{font-size:26rpx;font-weight:800;color:#172033}.map-desc{font-size:20rpx;color:#858D9D;margin-top:5rpx}.legend{display:flex;align-items:center;gap:7rpx;color:#7B8394;font-size:19rpx}.legend-dot{width:16rpx;height:16rpx;border-radius:4rpx}.key-dot{background:#5267D8;box-shadow:0 0 0 4rpx rgba(82,103,216,.16)}.muted-dot{margin-left:10rpx;background:#D8DCE4}.sequence-map{display:grid;grid-template-columns:repeat(20,minmax(0,1fr));gap:5rpx;padding:14rpx;border-radius:18rpx;background:#F7F8FA;border:2rpx solid #E7E9EF}.sequence-position{position:relative;display:flex;align-items:center;justify-content:center;aspect-ratio:1;border-radius:5rpx;font-size:16rpx;line-height:1}.sequence-position.muted{background:#DDE0E6;color:#9DA3AF}.sequence-position.key{z-index:2;background:#5267D8;color:#fff;font-weight:900;box-shadow:0 0 0 4rpx rgba(82,103,216,.2)}.sequence-position.active{z-index:3;background:#172033;transform:scale(1.35);box-shadow:0 6rpx 16rpx rgba(23,32,51,.45),0 0 0 5rpx rgba(82,103,216,.28)}.rank{position:absolute;top:-10rpx;right:-8rpx;min-width:20rpx;height:20rpx;line-height:20rpx;border-radius:10rpx;background:#fff;color:#5267D8;font-size:13rpx;text-align:center;box-shadow:0 2rpx 6rpx rgba(23,32,51,.22)}.base-letter{font-size:16rpx}.nav{margin-top:24rpx}.nav button{width:46%;font-size:25rpx;border-radius:14rpx;background:#5267D8;color:#fff}.nav button[disabled]{background:#E8EBF2;color:#9AA1B1}
