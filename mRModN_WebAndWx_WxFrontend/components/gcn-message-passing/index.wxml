<view class="gcn-root">
  <view class="layer-row"><text class="block-title">Message Layer</text><picker wx:if="{{layerLabels.length}}" mode="selector" range="{{layerLabels}}" value="{{layerIndex}}" bindchange="onLayerChange"><view class="layer-picker">{{layerLabels[layerIndex]}}⌄</view></picker></view>
  <view class="legend"><view><text class="dot target"></text><text>Target Site</text></view><view><text class="dot message"></text><text>Message Sources</text></view><view><text class="dot muted"></text><text>Other Sites</text></view></view>
  <view class="sequence-card">
    <view class="sequence-grid"><view wx:for="{{visibleSites}}" wx:key="index" class="site {{item.role}}" style="opacity:{{item.role === 'message' ? item.opacity : 1}}"><text class="position">{{item.position}}</text><text class="base">{{item.base}}</text><text class="score">{{item.strengthText}}</text></view></view>
    <view class="pager"><button disabled="{{!canPrev}}" bindtap="previous">Previous</button><text>{{windowStart + 1}}–{{windowEnd}} / {{sites.length}}</text><button disabled="{{!canNext}}" bindtap="next">Next</button></view>
  </view>
  <view class="ranking"><text class="block-title">Message Strength Ranking</text><view wx:if="{{!messages.length}}" class="empty">No messages were returned for this layer.</view><view wx:for="{{messages}}" wx:key="index" class="rank-row"><text class="rank">{{item.rank}}</text><text>{{item.base}}{{item.position}} → target site</text><text class="strength">{{item.strengthText}}</text></view></view>
  <view class="graph-title"><text class="block-title">RNA Structure Mapping</text><text>Target and message nodes are highlighted</text></view>
  <rna-graph graph="{{result}}" sequence="{{sequence}}" highlighted-indices="{{highlightedIndices}}" selected-index="{{selectedIndex}}" bindselect="onGraphSelect"></rna-graph>
</view>
