.gcn-root{display:flex;flex-direction:column;gap:20rpx}.layer-row,.graph-title{display:flex;align-items:center;justify-content:space-between}.block-title{font-size:28rpx;font-weight:800;color:#39434A}.layer-picker{min-width:210rpx;padding:16rpx 20rpx;background:#E4E9EC;border:1rpx solid #CBD4D9;border-radius:14rpx;color:#607283;font-weight:700}.legend{display:flex;gap:20rpx;flex-wrap:wrap;color:#6F777B;font-size:22rpx}.legend view{display:flex;align-items:center;gap:8rpx}.dot{width:18rpx;height:18rpx;border-radius:50%}.dot.target{background:#B27C6C}.dot.message{background:#728B7B}.dot.muted{background:#C8C8C3}.sequence-card,.ranking{background:#FAF9F6;border:2rpx solid #D8D5CE;border-radius:24rpx;padding:22rpx;box-shadow:0 8rpx 24rpx rgba(58,67,70,.05)}.sequence-grid{display:grid;grid-template-columns:repeat(10,minmax(0,1fr));gap:7rpx}.site{min-width:0;border:2rpx solid #D6D4CE;border-radius:12rpx;background:#E9E8E3;text-align:center;padding:8rpx 2rpx;color:#858B89}.site.target{border-color:#C49182;background:#F0E2DD;color:#87584D;box-shadow:0 0 0 4rpx rgba(178,124,108,.15)}.site.message{border-color:#94A697;background:#E5ECE7;color:#526C5A}.position,.base,.score{display:block;white-space:nowrap;overflow:hidden}.position{font-size:18rpx}.base{font-size:30rpx;line-height:1.25;font-weight:900}.score{font-size:16rpx}.pager{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:16rpx;margin-top:20rpx;color:#6F777B;font-size:20rpx}.pager button{margin:0;height:66rpx;line-height:66rpx;background:#718394;color:#FEFDFC;border-radius:14rpx;font-size:23rpx}.pager button[disabled]{background:#E2E1DC;color:#979B9B}.rank-row{display:grid;grid-template-columns:50rpx 1fr auto;gap:12rpx;padding:15rpx 0;border-bottom:1rpx solid #E7E3DD}.rank{width:40rpx;height:40rpx;line-height:40rpx;text-align:center;border-radius:50%;background:#E5ECE7;color:#526C5A;font-weight:800}.strength{font-family:monospace;color:#526C5A;font-weight:700}.empty{padding:32rpx 0;color:#858B89;text-align:center}.graph-title{align-items:flex-end;color:#6F777B;font-size:20rpx}
