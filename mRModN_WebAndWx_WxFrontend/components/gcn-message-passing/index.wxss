.gcn-root{display:flex;flex-direction:column;gap:20rpx}.layer-row,.graph-title{display:flex;align-items:center;justify-content:space-between}.block-title{font-size:28rpx;font-weight:800;color:#172033}.layer-picker{min-width:210rpx;padding:16rpx 20rpx;background:#EEF1FF;border-radius:14rpx;color:#4057C5;font-weight:700}.legend{display:flex;gap:20rpx;flex-wrap:wrap;color:#697386;font-size:22rpx}.legend view{display:flex;align-items:center;gap:8rpx}.dot{width:18rpx;height:18rpx;border-radius:50%}.dot.target{background:#E36B50}.dot.message{background:#39A6A3}.dot.muted{background:#C9CFDA}.sequence-card,.ranking{background:#fff;border:2rpx solid #E5E8F0;border-radius:24rpx;padding:22rpx}.sequence-grid{display:grid;grid-template-columns:repeat(10,minmax(0,1fr));gap:7rpx}.site{min-width:0;border:2rpx solid #DDE2EA;border-radius:12rpx;background:#F1F3F6;text-align:center;padding:8rpx 2rpx;color:#8A92A2}.site.target{border-color:#E36B50;background:#FFF0EC;color:#B7432E;box-shadow:0 0 0 4rpx rgba(227,107,80,.15)}.site.message{border-color:#39A6A3;background:#E9FAF8;color:#167A78}.position,.base,.score{display:block;white-space:nowrap;overflow:hidden}.position{font-size:18rpx}.base{font-size:30rpx;line-height:1.25;font-weight:900}.score{font-size:16rpx}.pager{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:16rpx;margin-top:20rpx;color:#778094;font-size:20rpx}.pager button{margin:0;height:66rpx;line-height:66rpx;background:#5267D8;color:#fff;border-radius:14rpx;font-size:23rpx}.pager button[disabled]{background:#E4E7ED;color:#A4ABBA}.rank-row{display:grid;grid-template-columns:50rpx 1fr auto;gap:12rpx;padding:15rpx 0;border-bottom:1rpx solid #EDF0F5}.rank{width:40rpx;height:40rpx;line-height:40rpx;text-align:center;border-radius:50%;background:#E9FAF8;color:#167A78;font-weight:800}.strength{font-family:monospace;color:#167A78;font-weight:700}.empty{padding:32rpx 0;color:#8A92A2;text-align:center}.graph-title{align-items:flex-end;color:#778094;font-size:20rpx}
