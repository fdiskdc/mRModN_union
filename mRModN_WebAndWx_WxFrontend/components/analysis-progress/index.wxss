.mask{position:fixed;inset:0;z-index:200;background:rgba(57,67,74,.42);display:flex;align-items:center;justify-content:center;padding:48rpx}.panel{width:100%;background:#FAF9F6;border:2rpx solid #D8D5CE;border-radius:28rpx;padding:48rpx 36rpx;text-align:center;box-shadow:0 28rpx 80rpx rgba(57,67,74,.18)}.spinner{width:72rpx;height:72rpx;border:8rpx solid #E4E9EC;border-top-color:#718394;border-radius:50%;margin:0 auto 26rpx;animation:spin 1s linear infinite}.title{display:block;font-size:32rpx;font-weight:700;color:#39434A}.count{display:block;color:#607283;margin:10rpx 0 24rpx}.track{height:14rpx;background:#E4E9EC;border-radius:10rpx;overflow:hidden}.bar{height:100%;min-width:10%;background:linear-gradient(90deg,#718394,#7E9183);border-radius:10rpx;transition:.3s}.hint{display:block;color:#6F777B;font-size:24rpx;margin-top:24rpx}@keyframes spin{to{transform:rotate(360deg)}}
