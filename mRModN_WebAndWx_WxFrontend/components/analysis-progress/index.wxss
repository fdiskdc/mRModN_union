.mask{position:fixed;inset:0;z-index:200;background:rgba(23,32,51,.42);display:flex;align-items:center;justify-content:center;padding:48rpx}.panel{width:100%;background:#fff;border-radius:28rpx;padding:48rpx 36rpx;text-align:center;box-shadow:0 28rpx 80rpx rgba(23,32,51,.2)}.spinner{width:72rpx;height:72rpx;border:8rpx solid #EEF1FF;border-top-color:#5267D8;border-radius:50%;margin:0 auto 26rpx;animation:spin 1s linear infinite}.title{display:block;font-size:32rpx;font-weight:700;color:#172033}.count{display:block;color:#5267D8;margin:10rpx 0 24rpx}.track{height:14rpx;background:#EEF1FF;border-radius:10rpx;overflow:hidden}.bar{height:100%;min-width:10%;background:linear-gradient(90deg,#5267D8,#28A69A);border-radius:10rpx;transition:.3s}.hint{display:block;color:#6C7588;font-size:24rpx;margin-top:24rpx}@keyframes spin{to{transform:rotate(360deg)}}
