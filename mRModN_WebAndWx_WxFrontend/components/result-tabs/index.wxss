.tabs{position:fixed;z-index:90;left:0;right:0;bottom:0;padding:12rpx 20rpx calc(12rpx + env(safe-area-inset-bottom));background:rgba(255,255,255,.97);border-top:2rpx solid #E8EBF2;box-shadow:0 -12rpx 30rpx rgba(23,32,51,.09);backdrop-filter:blur(18rpx)}.row{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8rpx}.tab{min-width:0;padding:18rpx 4rpx;text-align:center;border-radius:16rpx;color:#7B8394;background:transparent;font-size:23rpx;font-weight:600}.tab text{display:block;white-space:nowrap}.tab.active{color:#fff;background:#5267D8;box-shadow:0 8rpx 20rpx rgba(82,103,216,.28)}
