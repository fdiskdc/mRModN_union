.tabs{position:fixed;z-index:90;left:0;right:0;bottom:0;padding:12rpx 20rpx calc(12rpx + env(safe-area-inset-bottom));background:rgba(250,249,246,.97);border-top:2rpx solid #D8D5CE;box-shadow:0 -10rpx 28rpx rgba(58,67,70,.08);backdrop-filter:blur(18rpx)}.row{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8rpx}.tab{min-width:0;padding:18rpx 4rpx;text-align:center;border-radius:16rpx;color:#7F8788;background:transparent;font-size:23rpx;font-weight:600}.tab text{display:block;white-space:nowrap}.tab.active{color:#607283;background:#E4E9EC;box-shadow:inset 0 0 0 1rpx #CBD4D9}
