<view class="card"><view class="toolbar"><view class="switch {{showBackbone?'active':''}}" bindtap="toggleBackbone">主链</view><view class="switch {{showPairs?'active':''}}" bindtap="togglePairs">配对</view><view class="reset" bindtap="reset">重置视图</view></view><canvas type="2d" id="rnaCanvas" class="canvas" bindtouchstart="touchStart" catchtouchmove="touchMove" bindtouchend="touchEnd"></canvas><view wx:if="{{selectedNode}}" class="node-info"><text>位置 {{selectedNode.position}}</text><text>{{selectedNode.base}}</text></view><text class="hint">单指拖动 · 双指缩放 · 双击重置 · 点击查看节点</text></view>
