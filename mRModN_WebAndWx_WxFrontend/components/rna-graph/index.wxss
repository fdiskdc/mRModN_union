.card{background:#FAF9F6;border:2rpx solid #D8D5CE;border-radius:24rpx;padding:20rpx;box-shadow:0 8rpx 24rpx rgba(58,67,70,.05)}.toolbar{display:flex;gap:12rpx;align-items:center;margin-bottom:14rpx}.switch,.reset{padding:12rpx 18rpx;border:1rpx solid #DEDBD4;border-radius:12rpx;background:#EEEDE9;color:#6F777B;font-size:22rpx}.switch.active{background:#E4E9EC;border-color:#C8D2D8;color:#607283;font-weight:700}.reset{margin-left:auto}.canvas{width:100%;height:760rpx;background:#E9EBE8;border:2rpx solid #DADDD8;border-radius:18rpx}.node-info{display:flex;justify-content:space-between;background:#F0E2DD;color:#87584D;border:2rpx solid #E2CFC9;border-radius:14rpx;padding:18rpx 22rpx;margin-top:14rpx;font-weight:700}.hint{display:block;text-align:center;color:#858B89;font-size:21rpx;margin-top:14rpx}
