.card{background:#fff;border:2rpx solid #E8EBF2;border-radius:24rpx;padding:20rpx}.toolbar{display:flex;gap:12rpx;align-items:center;margin-bottom:12rpx}.switch,.reset{padding:12rpx 18rpx;border-radius:12rpx;background:#F2F4F8;color:#6C7588;font-size:22rpx}.switch.active{background:#EEF1FF;color:#5267D8}.reset{margin-left:auto}.canvas{width:100%;height:760rpx;background:#FBFCFE;border-radius:18rpx}.node-info{display:flex;justify-content:space-between;background:#EEF1FF;color:#5267D8;border-radius:14rpx;padding:18rpx 22rpx;margin-top:14rpx;font-weight:700}.hint{display:block;text-align:center;color:#9AA1B1;font-size:21rpx;margin-top:14rpx}
